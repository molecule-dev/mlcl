#!/bin/sh
# commit-staged-paths: --index-only
set -e

staged_diff() {
  git -c core.quotePath=false diff --cached --no-renames ${MOL_PRECOMMIT_BASE:+"$MOL_PRECOMMIT_BASE"} "$@"
}

run_check() {
  name="$1"
  shift
  "$@" || { echo "pre-commit: $name failed" >&2; exit 1; }
}

# Fast secret scan — blocks a commit that introduces a high-confidence secret
# (staged added lines only). Runs first so a leaked key fails before the slower
# format/lint pass. Bypass a reviewed false positive with: git commit --no-verify
run_check precommit-secret-scan node scripts/precommit-secret-scan.mjs

# Every relative import in this commit must name a file the commit carries. A file
# git ignores or never tracked still resolves in this checkout, so local builds and
# tests pass while CI fails on a clean clone (2026-11-13, molecule: an ignored
# `bag.svelte.js`). The check lives in molecule/scripts; skipped in a standalone clone.
if [ -f ../molecule/scripts/check-tracked-imports.mjs ]; then
  run_check check-tracked-imports node ../molecule/scripts/check-tracked-imports.mjs --staged
fi

# The lock must record exactly the dependencies package.json declares: CI and
# the Release workflow install with `npm ci`, which refuses any difference.
# Checked on the staged files; skipped in a standalone clone.
if staged_diff --name-only --diff-filter=ACMD | grep -qE '(^|/)package(-lock)?\.json$'; then
  if [ -f ../scripts/check-lockfile-sync.mjs ]; then
    (cd .. && run_check check-lockfile-sync node scripts/check-lockfile-sync.mjs mlcl --staged)
  fi
fi

# Template gates run on the carried seed data, tests, and template configs.
# A shared lint config changes what every scaffold receives.
E2E_SLUGS=$(staged_diff --name-only --diff-filter=ACDMT |
  grep -E '^templates/apps/[^/]+/(e2e/|api/(fixtures/|.*[Ss]eed))' |
  cut -d/ -f3 | sort -u)
LINT_SLUGS=""
LINT_ALL=0
if [ -x ../node_modules/.bin/eslint ]; then
  LINT_STAGED=$(staged_diff --name-only --diff-filter=ACDMT)
  if printf '%s\n' "$LINT_STAGED" | grep -qE '^templates/shared/(eslint\.config\.js\.tpl|[^/]+\.mjs)$'; then
    LINT_ALL=1
  else
    LINT_SLUGS=$(printf '%s\n' "$LINT_STAGED" |
      grep -E '^templates/apps/[^/]+/(app|api)/(src/|eslint\.config\.js$)' |
      cut -d/ -f3 | sort -u)
  fi
fi

# Root prettier and eslint use the same scopes and options as npm run
# format:check / lint. Template eslint uses each template's own config.
STAGED=$(staged_diff --name-only --diff-filter=AMT)
FMT=$(printf '%s\n' "$STAGED" | grep -E '\.(ts|tsx|js|jsx|mjs|cjs|md|css|scss|html|yaml|yml)$|^templates/apps/[^/]+/api/fixtures/[^/]+\.json$' || true)
LINT=$(printf '%s\n' "$STAGED" | grep -E '^(src|scripts)/.*\.(ts|tsx|js|jsx|mjs|cjs)$' || true)

if [ -n "$FMT$LINT$E2E_SLUGS$LINT_SLUGS" ] || [ "$LINT_ALL" = 1 ]; then
  TREE=$(mktemp -d "${TMPDIR:-/tmp}/mlcl-index.XXXXXX")
  trap 'rm -rf "$TREE"' EXIT
  mkdir "$TREE/tree"
  staged_diff --name-only --diff-filter=AMT -z > "$TREE/paths"
  git ls-files -z -- package.json 'tsconfig*.json' 'eslint.config.*' \
    ':(glob)**/.prettier*' ':(glob)**/prettier.config.*' \
    scripts/verify-template-e2e-demo-data.mjs scripts/verify-template-lint.mjs >> "$TREE/paths"
  if [ "$LINT_ALL" = 1 ]; then
    git ls-files -z -- templates >> "$TREE/paths"
  elif [ -n "$E2E_SLUGS$LINT_SLUGS" ]; then
    git ls-files -z -- templates/shared >> "$TREE/paths"
    # Template slugs are directory names without whitespace.
    for slug in $E2E_SLUGS $LINT_SLUGS; do
      git ls-files -z -- "templates/apps/$slug" >> "$TREE/paths"
    done
  fi
  git checkout-index --force --prefix="$TREE/tree/" --stdin -z < "$TREE/paths"
  if [ -x node_modules/.bin/prettier ] && [ -x node_modules/.bin/eslint ]; then
    ln -s "$PWD/node_modules" "$TREE/tree/node_modules"
  elif [ -d ../node_modules ]; then
    ln -s "$(cd .. && pwd)/node_modules" "$TREE/tree/node_modules"
  fi

  (
    cd "$TREE/tree"
    if [ -n "$E2E_SLUGS" ]; then
      run_check verify-template-e2e-demo-data node scripts/verify-template-e2e-demo-data.mjs $E2E_SLUGS
    fi
    if [ "$LINT_ALL" = 1 ] || [ -n "$LINT_SLUGS" ]; then
      run_check verify-template-lint node scripts/verify-template-lint.mjs $LINT_SLUGS
    fi

    # Prettier rejects explicit symlinks before it consults .prettierignore.
    FMT=$(printf '%s\n' "$FMT" | while IFS= read -r f; do
      if [ -f "$f" ] && [ ! -L "$f" ]; then printf '%s\n' "$f"; fi
    done)
    if [ -n "$FMT" ]; then
      printf '%s\n' "$FMT" | tr '\n' '\000' |
        run_check prettier xargs -0 ./node_modules/.bin/prettier --check --ignore-unknown --
    fi
    if [ -n "$LINT" ]; then
      printf '%s\n' "$LINT" | tr '\n' '\000' |
        run_check eslint xargs -0 ./node_modules/.bin/eslint --no-error-on-unmatched-pattern --max-warnings 0 --
    fi
  )
fi

# A registry entry is half of a molecule README's input (its description, runtime dependencies, a
# locale bond the feature now lists), so a registry commit must not leave molecule HEAD's READMEs
# stale (2026-11-22: 73c34e11fe recorded runtime dependencies for six packages and their READMEs
# stayed stale until the release's docs gate refused it). Checks only the packages whose entries
# changed, against molecule HEAD; a pin or toolchain edit checks nothing. It also refuses a changed
# entry that records molecule work HEAD does not have (2026-11-25: 14d45864c4 recorded exports and peers
# from uncommitted molecule edits; sync-registry reads the working tree). Reads the index, so it runs
# for a private-index commit too. Skipped without a molecule checkout or tsx.
if staged_diff --name-only -- registry.json | grep -q . &&
  [ -d ../molecule/.git ] && { [ -d node_modules/tsx ] || [ -d ../node_modules/tsx ]; }; then
  run_check check-registry-docs node --import tsx scripts/check-registry-docs.mjs \
    ${MOL_PRECOMMIT_BASE:+"--base=$MOL_PRECOMMIT_BASE"}
fi

# The vendored scanner comparison also reads the workspace working tree.
if [ "${1:-}" = --index-only ]; then exit 0; fi

# Secret-scanner drift (cross-repo). BOTH copies here are vendored from the
# workspace canonical (../scripts/precommit-secret-scan.mjs): the hook's own
# scanner, and templates/shared/*.tpl — which mlcl create copies VERBATIM into
# every scaffolded user project, so a stale template ships its false positives
# to every user. Only checked when a copy is staged; skipped in a standalone clone.
if staged_diff --name-only --diff-filter=ACM |
  grep -qE '^(scripts/precommit-secret-scan\.mjs|templates/shared/precommit-secret-scan\.mjs\.tpl)$'; then
  if [ -f ../scripts/sync-secret-scanner.mjs ]; then
    (cd .. && node scripts/sync-secret-scanner.mjs --check) || exit 1
  fi
fi

# ESLint copy drift (cross-repo). Each flagship workspace's eslint.config.js is a copy of
# templates/shared/eslint.config.js.tpl, and templates/shared/prefer-generated-resource-clients.mjs
# is a copy of @molecule/eslint-config's rule (../scripts/sync-eslint-rules.mjs). Only checked
# when one of them is staged; skipped in a standalone clone.
if staged_diff --name-only --diff-filter=ACM |
  grep -qE '^templates/(shared/(eslint\.config\.js\.tpl|prefer-generated-resource-clients\.mjs)|apps/[^/]+/(app|api)/eslint\.config\.js)$'; then
  if [ -f ../scripts/sync-eslint-rules.mjs ]; then
    (cd .. && node scripts/sync-eslint-rules.mjs --check) || exit 1
  fi
fi
