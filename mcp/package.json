{
  "name": "molecule-mcp",
  "version": "0.1.0",
  "description": "MCP server exposing the Molecule.dev package ecosystem — search, templates, scaffolding — to any MCP-capable coding agent",
  "author": "Molecule Dev, Inc. (https://molecule.dev)",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "molecule-mcp": "./bin/run.js",
    "molecule-mcp-serve": "./bin/serve.js"
  },
  "files": [
    "/bin",
    "/dist",
    "/assets",
    "/README.md"
  ],
  "scripts": {
    "build": "shx rm -rf dist && tsc -b",
    "smoke": "node scripts/smoke.mjs",
    "serve": "node dist/http.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.17.0",
    "execa": "10.0.0",
    "zod": "3.25.76",
    "express": "5.2.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.1.2",
    "shx": "0.4.0",
    "typescript": "6.0.3"
  }
}
