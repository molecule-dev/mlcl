{
  "name": "molecule-mcp",
  "version": "0.3.6",
  "description": "MCP server for the Molecule.dev packages: lets any coding agent find, read, add, wire and swap composable @molecule/* packages in any JavaScript or TypeScript project",
  "author": "Molecule Dev, Inc. (https://molecule.dev)",
  "license": "Apache-2.0",
  "homepage": "https://www.molecule.dev/mlcl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/molecule-dev/mlcl.git",
    "directory": "mcp"
  },
  "bugs": {
    "url": "https://github.com/molecule-dev/mlcl/issues"
  },
  "type": "module",
  "imports": {
    "#cli-command": "./assets/cli-command.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "molecule-mcp": "bin/run.js",
    "molecule-mcp-serve": "bin/serve.js"
  },
  "files": [
    "/bin",
    "/dist",
    "/assets",
    "/README.md"
  ],
  "scripts": {
    "build": "shx rm -rf dist && tsc -b",
    "gen:package-search": "node ../scripts/generate-mcp-package-search.mjs",
    "smoke": "node scripts/smoke.mjs",
    "serve": "node dist/http.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "execa": "10.2.1",
    "zod": "4.6.7",
    "express": "5.3.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "shx": "0.4.0",
    "typescript": "6.0.3"
  }
}
