    <h2>1. \u054A\u0561\u0575\u0574\u0561\u0576\u0576\u0565\u0580</h2>
    <p>\u0555\u0563\u057F\u057E\u0565\u056C\u0578\u057E \u0561\u0575\u057D \u056F\u0561\u0575\u0584\u0568\u057B\u0568\u055D \u0564\u0578\u0582\u0584 \u0570\u0561\u0574\u0561\u0571\u0561\u0575\u0576\u0578\u0582\u0574 \u0565\u0584 \u057A\u0561\u0580\u057F\u0561\u057E\u0578\u0580\u057E\u0565\u056C \u0561\u0575\u057D \u053E\u0561\u057C\u0561\u0575\u0578\u0582\u0569\u0575\u0561\u0576 \u057A\u0561\u0575\u0574\u0561\u0576\u0576\u0565\u0580\u0578\u057E \u0587 \u0570\u0561\u0574\u0561\u0571\u0561\u0575\u0576\u0578\u0582\u0574 \u0565\u0584, \u0578\u0580 \u0564\u0578\u0582\u0584 \u057A\u0561\u057F\u0561\u057D\u056D\u0561\u0576\u0561\u057F\u0578\u0582 \u0565\u0584 \u0581\u0561\u0576\u056F\u0561\u0581\u0561\u056E \u057F\u0565\u0572\u0561\u056F\u0561\u0576 \u0585\u0580\u0565\u0576\u0584\u0576\u0565\u0580\u056B \u0570\u0565\u057F \u0570\u0561\u0574\u0561\u0571\u0561\u0575\u0576\u0561\u0563\u0580\u056B \u0570\u0561\u0574\u0561\u0580: \u0535\u0569\u0565 \u0570\u0561\u0574\u0561\u0571\u0561\u0575\u0576 \u0579\u0565\u0584 \u0561\u0575\u057D \u057A\u0561\u0575\u0574\u0561\u0576\u0576\u0565\u0580\u056B\u0581 \u0578\u0580\u0587\u0567 \u0574\u0565\u056F\u056B \u0570\u0565\u057F, \u0571\u0565\u0566 \u0561\u0580\u0563\u0565\u056C\u057E\u0578\u0582\u0574 \u0567 \u0574\u0578\u0582\u057F\u0584 \u0563\u0578\u0580\u056E\u0565\u056C \u0561\u0575\u057D \u056F\u0561\u0575\u0584\u0568\u057B: \u0531\u0575\u057D \u056F\u0561\u0575\u0584\u0568\u057B\u0578\u0582\u0574 \u057A\u0561\u0580\u0578\u0582\u0576\u0561\u056F\u057E\u0561\u056E \u0576\u0575\u0578\u0582\u0569\u0565\u0580\u0568 \u057A\u0561\u0577\u057F\u057A\u0561\u0576\u057E\u0561\u056E \u0565\u0576 \u0570\u0565\u0572\u056B\u0576\u0561\u056F\u0561\u0575\u056B\u0576 \u056B\u0580\u0561\u057E\u0578\u0582\u0576\u0584\u056B \u0587 \u0561\u057A\u0580\u0561\u0576\u0584\u0561\u0575\u056B\u0576 \u0576\u0577\u0561\u0576\u056B \u0585\u0580\u0565\u0576\u0584\u0578\u057E:</p>
    <h2>2. \u0555\u0563\u057F\u0561\u0563\u0578\u0580\u056E\u0574\u0561\u0576 \u056C\u056B\u0581\u0565\u0576\u0566\u056B\u0561</h2>
    <p>\u054F\u0580\u057E\u0578\u0582\u0574 \u0567 \u0569\u0578\u0582\u0575\u056C\u057F\u057E\u0578\u0582\u0569\u0575\u0578\u0582\u0576\u055D \u0561\u0575\u057D \u056F\u0561\u0575\u0584\u0568\u057B\u056B \u0576\u0575\u0578\u0582\u0569\u0565\u0580\u056B \u0574\u0565\u056F \u0585\u0580\u056B\u0576\u0561\u056F\u0568 \u056A\u0561\u0574\u0561\u0576\u0561\u056F\u0561\u057E\u0578\u0580\u0561\u057A\u0565\u057D \u0576\u0565\u0580\u0562\u0565\u057C\u0576\u0565\u056C\u0578\u0582 \u0574\u056B\u0561\u0575\u0576 \u0561\u0576\u0571\u0576\u0561\u056F\u0561\u0576, \u0578\u0579 \u0561\u057C\u0587\u057F\u0580\u0561\u0575\u056B\u0576 \u056A\u0561\u0574\u0561\u0576\u0561\u056F\u0561\u057E\u0578\u0580 \u0564\u056B\u057F\u0574\u0561\u0576 \u0570\u0561\u0574\u0561\u0580: \u054D\u0561 \u056C\u056B\u0581\u0565\u0576\u0566\u056B\u0561\u0575\u056B \u057F\u0580\u0561\u0574\u0561\u0564\u0580\u0578\u0582\u0574 \u0567, \u0578\u0579 \u057D\u0565\u0583\u0561\u056F\u0561\u0576\u0578\u0582\u0569\u0575\u0561\u0576 \u0583\u0578\u056D\u0561\u0576\u0581\u0578\u0582\u0574, \u0587 \u0561\u0575\u057D \u056C\u056B\u0581\u0565\u0576\u0566\u056B\u0561\u0575\u056B \u0576\u0565\u0580\u0584\u0578 \u0564\u0578\u0582\u0584 \u0579\u0565\u0584 \u056F\u0561\u0580\u0578\u0572.</p>
    <ul>
      <li>\u0583\u0578\u0583\u0578\u056D\u0565\u056C \u056F\u0561\u0574 \u057A\u0561\u057F\u0573\u0565\u0576\u0565\u056C \u0576\u0575\u0578\u0582\u0569\u0565\u0580\u0568.</li>
      <li>\u0576\u0575\u0578\u0582\u0569\u0565\u0580\u0568 \u0585\u0563\u057F\u0561\u0563\u0578\u0580\u056E\u0565\u056C \u0561\u057C\u0587\u057F\u0580\u0561\u0575\u056B\u0576 \u0576\u057A\u0561\u057F\u0561\u056F\u0578\u057E \u056F\u0561\u0574 \u0570\u0561\u0576\u0580\u0561\u0575\u056B\u0576 \u0581\u0578\u0582\u0581\u0561\u0564\u0580\u0574\u0561\u0576 \u0570\u0561\u0574\u0561\u0580.</li>
      <li>\u0583\u0578\u0580\u0571\u0565\u056C \u0570\u0561\u056F\u0561\u0564\u0561\u0580\u0571 \u0574\u0577\u0561\u056F\u0565\u056C \u0561\u0575\u057D \u056F\u0561\u0575\u0584\u0568\u057B\u0578\u0582\u0574 \u057A\u0561\u0580\u0578\u0582\u0576\u0561\u056F\u057E\u0561\u056E \u0581\u0561\u0576\u056F\u0561\u0581\u0561\u056E \u056E\u0580\u0561\u0563\u0580\u0561\u0575\u056B\u0576 \u0561\u057A\u0561\u0570\u0578\u057E\u0578\u0582\u0569\u0575\u0578\u0582\u0576.</li>
      <li>\u0576\u0575\u0578\u0582\u0569\u0565\u0580\u056B\u0581 \u0570\u0565\u057C\u0561\u0581\u0576\u0565\u056C \u0570\u0565\u0572\u056B\u0576\u0561\u056F\u0561\u0575\u056B\u0576 \u056B\u0580\u0561\u057E\u0578\u0582\u0576\u0584\u056B \u056F\u0561\u0574 \u0561\u0575\u056C \u057D\u0565\u0583\u0561\u056F\u0561\u0576\u0561\u057F\u056B\u0580\u0561\u056F\u0561\u0576 \u0576\u0577\u0561\u0576\u0576\u0565\u0580. \u056F\u0561\u0574</li>
      <li>\u0576\u0575\u0578\u0582\u0569\u0565\u0580\u0568 \u0583\u0578\u056D\u0561\u0576\u0581\u0565\u056C \u0561\u0575\u056C \u0561\u0576\u0571\u056B\u0576 \u056F\u0561\u0574 \u0576\u0575\u0578\u0582\u0569\u0565\u0580\u0568 \u00AB\u0570\u0561\u0575\u0565\u056C\u0565\u056C\u00BB \u0561\u0575\u056C \u057D\u0565\u0580\u057E\u0565\u0580\u056B \u057E\u0580\u0561:</li>
    </ul>
    <p>\u054D\u0561 \u0574\u0565\u0566 \u0569\u0578\u0582\u0575\u056C \u057F\u0561\u056C\u056B\u057D \u056E\u0561\u057C\u0561\u0575\u0578\u0582\u0569\u0575\u0578\u0582\u0576\u0576\u0565\u0580\u0568 \u0564\u0561\u0564\u0561\u0580\u0565\u0581\u0576\u0565\u056C\u0578\u0582 \u0561\u0575\u057D \u057D\u0561\u0570\u0574\u0561\u0576\u0561\u0583\u0561\u056F\u0578\u0582\u0574\u0576\u0565\u0580\u056B\u0581 \u0578\u0580\u0587\u0567 \u0574\u0565\u056F\u056B \u056D\u0561\u056D\u057F\u0574\u0561\u0576 \u0564\u0565\u057A\u0584\u0578\u0582\u0574: \u0534\u0561\u0564\u0561\u0580\u0565\u0581\u0574\u0561\u0576 \u0564\u0565\u057A\u0584\u0578\u0582\u0574\u055D \u0571\u0565\u0580 \u0564\u056B\u057F\u0574\u0561\u0576 \u056B\u0580\u0561\u057E\u0578\u0582\u0576\u0584\u0568 \u0576\u0578\u0582\u0575\u0576\u057A\u0565\u057D \u056F\u0564\u0561\u0564\u0561\u0580\u0565\u0581\u057E\u056B, \u0587 \u0564\u0578\u0582\u0584 \u057A\u0565\u057F\u0584 \u0567 \u0578\u0579\u0576\u0579\u0561\u0581\u0576\u0565\u0584 \u0571\u0565\u0580 \u057F\u056B\u0580\u0578\u0582\u0575\u0569\u0578\u0582\u0574 \u0563\u057F\u0576\u057E\u0578\u0572 \u0576\u0565\u0580\u0562\u0565\u057C\u0576\u057E\u0561\u056E \u0576\u0575\u0578\u0582\u0569\u0565\u0580\u0568\u055D \u0561\u0576\u056F\u0561\u056D \u057F\u057A\u0561\u0563\u056B\u0580 \u0569\u0565 \u0567\u056C\u0565\u056F\u057F\u0580\u0578\u0576\u0561\u0575\u056B\u0576 \u0571\u0587\u0561\u0579\u0561\u0583\u0578\u057E:</p>
    <h2>3. \u054A\u0561\u057F\u0561\u057D\u056D\u0561\u0576\u0561\u057F\u057E\u0578\u0582\u0569\u0575\u0561\u0576 \u0574\u0565\u0580\u056A\u0578\u0582\u0574</h2>
    <p>\u0531\u0575\u057D \u056F\u0561\u0575\u0584\u0568\u057B\u056B \u0562\u0578\u056C\u0578\u0580 \u0576\u0575\u0578\u0582\u0569\u0565\u0580\u0568 \u057F\u0580\u0561\u0574\u0561\u0564\u0580\u057E\u0578\u0582\u0574 \u0565\u0576 \u00AB\u056B\u0576\u0579\u057A\u0565\u057D \u056F\u0561\u00BB: \u0544\u0565\u0576\u0584 \u0565\u0580\u0561\u0577\u056D\u056B\u0584\u0576\u0565\u0580 \u0579\u0565\u0576\u0584 \u057F\u0561\u056C\u056B\u057D\u055D \u056C\u056B\u0576\u0565\u0576 \u0564\u0580\u0561\u0576\u0584 \u0578\u0582\u0572\u0572\u0561\u056F\u056B \u056F\u0561\u0574 \u0565\u0576\u0569\u0561\u0564\u0580\u057E\u0561\u056E, \u0564\u0580\u0561\u0576\u0578\u057E \u0574\u0565\u0580\u056A\u0565\u056C\u0578\u057E \u0562\u0578\u056C\u0578\u0580 \u0561\u0575\u056C \u0565\u0580\u0561\u0577\u056D\u056B\u0584\u0576\u0565\u0580\u0568: \u0532\u0561\u0581\u056B \u0561\u0575\u0564, \u0574\u0565\u0576\u0584 \u0579\u0565\u0576\u0584 \u0576\u0565\u0580\u056F\u0561\u0575\u0561\u0581\u0576\u0578\u0582\u0574 \u0561\u0575\u057D \u056F\u0561\u0575\u0584\u0568\u057B\u056B \u0576\u0575\u0578\u0582\u0569\u0565\u0580\u056B \u0585\u0563\u057F\u0561\u0563\u0578\u0580\u056E\u0574\u0561\u0576 \u0573\u0577\u0563\u0580\u057F\u0578\u0582\u0569\u0575\u0561\u0576 \u056F\u0561\u0574 \u0570\u0578\u0582\u057D\u0561\u056C\u056B\u0578\u0582\u0569\u0575\u0561\u0576 \u057E\u0565\u0580\u0561\u0562\u0565\u0580\u0575\u0561\u056C \u0578\u0580\u0587\u0567 \u0576\u0565\u0580\u056F\u0561\u0575\u0561\u0581\u0578\u0582\u0574\u0576\u0565\u0580 \u056F\u0561\u0574 \u0561\u0575\u057D \u056F\u0561\u0575\u0584\u0568\u057B\u056B\u0576 \u056F\u0561\u057A\u057E\u0561\u056E \u056F\u0561\u0575\u0584\u0565\u0580\u056B:</p>
    <h2>4. \u054D\u0561\u0570\u0574\u0561\u0576\u0561\u0583\u0561\u056F\u0578\u0582\u0574\u0576\u0565\u0580</h2>
    <p>\u0544\u0565\u0576\u0584 \u056F\u0561\u0574 \u0574\u0565\u0580 \u0574\u0561\u057F\u0561\u056F\u0561\u0580\u0561\u0580\u0576\u0565\u0580\u0568 \u057A\u0561\u057F\u0561\u057D\u056D\u0561\u0576\u0561\u057F\u057E\u0578\u0582 \u0579\u0565\u0576 \u056C\u056B\u0576\u056B \u0561\u0575\u057D \u056F\u0561\u0575\u0584\u0568\u057B\u056B \u0576\u0575\u0578\u0582\u0569\u0565\u0580\u056B \u0585\u0563\u057F\u0561\u0563\u0578\u0580\u056E\u0574\u0561\u0576 \u056F\u0561\u0574 \u0585\u0563\u057F\u0561\u0563\u0578\u0580\u056E\u0574\u0561\u0576 \u0561\u0576\u0570\u0576\u0561\u0580\u0561\u057E\u0578\u0580\u0578\u0582\u0569\u0575\u0561\u0574\u0562 \u0561\u057C\u0561\u057B\u0561\u0581\u0561\u056E \u0581\u0561\u0576\u056F\u0561\u0581\u0561\u056E \u057E\u0576\u0561\u057D\u056B \u0570\u0561\u0574\u0561\u0580, \u0576\u0578\u0582\u0575\u0576\u056B\u057D\u056F \u0565\u0569\u0565 \u0561\u0575\u057D \u056F\u0561\u0575\u0584\u0568\u057B\u056B \u056C\u056B\u0561\u0566\u0578\u0580\u0561\u057E\u0561\u056E \u0576\u0565\u0580\u056F\u0561\u0575\u0561\u0581\u0578\u0582\u0581\u056B\u0579\u0568 \u057F\u0565\u0572\u0565\u056F\u0561\u0581\u057E\u0561\u056E \u0567\u055D \u0562\u0561\u0576\u0561\u057E\u0578\u0580 \u056F\u0561\u0574 \u0563\u0580\u0561\u057E\u0578\u0580, \u0576\u0574\u0561\u0576 \u057E\u0576\u0561\u057D\u056B \u0570\u0576\u0561\u0580\u0561\u057E\u0578\u0580\u0578\u0582\u0569\u0575\u0561\u0576 \u0574\u0561\u057D\u056B\u0576:</p>
    <h2>5. \u054E\u0565\u0580\u0561\u0576\u0561\u0575\u0578\u0582\u0574\u0576\u0565\u0580 \u0587 \u057D\u056D\u0561\u056C\u0576\u0565\u0580</h2>
    <p>\u0531\u0575\u057D \u056F\u0561\u0575\u0584\u0568\u057B\u0578\u0582\u0574 \u0570\u0561\u0575\u057F\u0576\u057E\u0578\u0572 \u0576\u0575\u0578\u0582\u0569\u0565\u0580\u0568 \u056F\u0561\u0580\u0578\u0572 \u0565\u0576 \u057A\u0561\u0580\u0578\u0582\u0576\u0561\u056F\u0565\u056C \u057F\u0565\u056D\u0576\u056B\u056F\u0561\u056F\u0561\u0576, \u057F\u057A\u0561\u0563\u0580\u0561\u056F\u0561\u0576 \u056F\u0561\u0574 \u056C\u0578\u0582\u057D\u0561\u0576\u056F\u0561\u0580\u0579\u0561\u056F\u0561\u0576 \u057D\u056D\u0561\u056C\u0576\u0565\u0580: \u0544\u0565\u0576\u0584 \u0579\u0565\u0576\u0584 \u056D\u0578\u057D\u057F\u0561\u0576\u0561, \u0578\u0580 \u0561\u0575\u057D \u056F\u0561\u0575\u0584\u0568\u057B\u056B \u0576\u0575\u0578\u0582\u0569\u0565\u0580\u056B\u0581 \u0578\u0580\u0587\u0567 \u0574\u0565\u056F\u0568 \u0573\u0577\u0563\u0580\u056B\u057F, \u0561\u0574\u0562\u0578\u0572\u057B\u0561\u056F\u0561\u0576 \u056F\u0561\u0574 \u0561\u0580\u0564\u056B\u0561\u056F\u0561\u0576 \u0567: \u0544\u0565\u0576\u0584 \u056F\u0561\u0580\u0578\u0572 \u0565\u0576\u0584 \u0583\u0578\u056D\u0565\u056C \u0561\u0575\u057D \u056F\u0561\u0575\u0584\u0568\u057B\u056B \u0576\u0575\u0578\u0582\u0569\u0565\u0580\u0568 \u0581\u0561\u0576\u056F\u0561\u0581\u0561\u056E \u057A\u0561\u0570\u056B\u0576 \u0561\u057C\u0561\u0576\u0581 \u056E\u0561\u0576\u0578\u0582\u0581\u0574\u0561\u0576: \u0544\u0565\u0576\u0584 \u057A\u0561\u0580\u057F\u0561\u057E\u0578\u0580\u057E\u0561\u056E\u0578\u0582\u0569\u0575\u0578\u0582\u0576 \u0579\u0565\u0576\u0584 \u057D\u057F\u0561\u0576\u0571\u0576\u0578\u0582\u0574 \u0576\u0575\u0578\u0582\u0569\u0565\u0580\u0568 \u0569\u0561\u0580\u0574\u0561\u0581\u0576\u0565\u056C\u0578\u0582 \u0570\u0561\u0574\u0561\u0580:</p>
    <h2>6. \u0540\u0572\u0578\u0582\u0574\u0576\u0565\u0580</h2>
    <p>\u0544\u0565\u0576\u0584 \u0579\u0565\u0576\u0584 \u057E\u0565\u0580\u0561\u0576\u0561\u0575\u0565\u056C \u0561\u0575\u057D \u056F\u0561\u0575\u0584\u0568\u057B\u056B\u0576 \u056F\u0561\u057A\u057E\u0561\u056E \u0562\u0578\u056C\u0578\u0580 \u056F\u0561\u0575\u0584\u0565\u0580\u0568 \u0587 \u057A\u0561\u057F\u0561\u057D\u056D\u0561\u0576\u0561\u057F\u0578\u0582 \u0579\u0565\u0576\u0584 \u0576\u0574\u0561\u0576 \u056F\u0561\u057A\u057E\u0561\u056E \u056F\u0561\u0575\u0584\u056B \u0562\u0578\u057E\u0561\u0576\u0564\u0561\u056F\u0578\u0582\u0569\u0575\u0561\u0576 \u0570\u0561\u0574\u0561\u0580: \u0555\u0580\u0587\u0567 \u0570\u0572\u0574\u0561\u0576 \u0561\u057C\u056F\u0561\u0575\u0578\u0582\u0569\u0575\u0578\u0582\u0576\u0568 \u0579\u056B \u0565\u0576\u0569\u0561\u0564\u0580\u0578\u0582\u0574 \u0574\u0565\u0580 \u056F\u0578\u0572\u0574\u056B\u0581 \u056F\u0561\u0575\u0584\u056B \u0570\u0561\u057E\u0561\u0576\u0578\u0582\u0569\u0575\u0578\u0582\u0576: \u0555\u0580\u0587\u0567 \u056F\u0561\u057A\u057E\u0561\u056E \u056F\u0561\u0575\u0584\u056B \u0585\u0563\u057F\u0561\u0563\u0578\u0580\u056E\u0578\u0582\u0574\u0568 \u0585\u0563\u057F\u057E\u0578\u0572\u056B \u057D\u0565\u0583\u0561\u056F\u0561\u0576 \u057C\u056B\u057D\u056F\u0578\u057E \u0567:</p>
    <h2>7. \u053F\u0561\u0575\u0584\u056B \u056E\u0561\u057C\u0561\u0575\u0578\u0582\u0569\u0575\u0561\u0576 \u057A\u0561\u0575\u0574\u0561\u0576\u0576\u0565\u0580\u056B \u0583\u0578\u0583\u0578\u056D\u0578\u0582\u0569\u0575\u0578\u0582\u0576\u0576\u0565\u0580</h2>
    <p>\u0544\u0565\u0576\u0584 \u056F\u0561\u0580\u0578\u0572 \u0565\u0576\u0584 \u057E\u0565\u0580\u0561\u0576\u0561\u0575\u0565\u056C \u0561\u0575\u057D \u053E\u0561\u057C\u0561\u0575\u0578\u0582\u0569\u0575\u0561\u0576 \u057A\u0561\u0575\u0574\u0561\u0576\u0576\u0565\u0580\u0568 \u0561\u0575\u057D \u056F\u0561\u0575\u0584\u0568\u057B\u056B \u0570\u0561\u0574\u0561\u0580 \u0581\u0561\u0576\u056F\u0561\u0581\u0561\u056E \u057A\u0561\u0570\u056B\u0576 \u0561\u057C\u0561\u0576\u0581 \u0576\u0561\u056D\u0576\u0561\u056F\u0561\u0576 \u056E\u0561\u0576\u0578\u0582\u0581\u0574\u0561\u0576: \u0555\u0563\u057F\u057E\u0565\u056C\u0578\u057E \u0561\u0575\u057D \u056F\u0561\u0575\u0584\u0568\u057B\u0568\u055D \u0564\u0578\u0582\u0584 \u0570\u0561\u0574\u0561\u0571\u0561\u0575\u0576\u0578\u0582\u0574 \u0565\u0584 \u057A\u0561\u0580\u057F\u0561\u057E\u0578\u0580\u057E\u0565\u056C \u0561\u0575\u057D \u053E\u0561\u057C\u0561\u0575\u0578\u0582\u0569\u0575\u0561\u0576 \u057A\u0561\u0575\u0574\u0561\u0576\u0576\u0565\u0580\u056B \u0568\u0576\u0569\u0561\u0581\u056B\u056F \u057F\u0561\u0580\u0562\u0565\u0580\u0561\u056F\u0578\u057E:</p>
    <h2>8. \u0541\u0565\u0580 \u0563\u0561\u0572\u057F\u0576\u056B\u0578\u0582\u0569\u0575\u0578\u0582\u0576\u0568</h2>
    <p>\u053D\u0576\u0564\u0580\u0578\u0582\u0574 \u0565\u0576\u0584 \u056F\u0561\u0580\u0564\u0561\u056C \u0574\u0565\u0580 \u0533\u0561\u0572\u057F\u0576\u056B\u0578\u0582\u0569\u0575\u0561\u0576 \u0584\u0561\u0572\u0561\u0584\u0561\u056F\u0561\u0576\u0578\u0582\u0569\u0575\u0578\u0582\u0576\u0568:</p>
    <h2>9. \u053F\u056B\u0580\u0561\u057C\u0565\u056C\u056B \u0585\u0580\u0565\u0576\u0584</h2>
    <p>\u0531\u0575\u057D \u056F\u0561\u0575\u0584\u0568\u057B\u056B\u0576 \u057E\u0565\u0580\u0561\u0562\u0565\u0580\u0578\u0572 \u0581\u0561\u0576\u056F\u0561\u0581\u0561\u056E \u057A\u0561\u0570\u0561\u0576\u057B\u0568 \u056F\u056F\u0561\u057C\u0561\u057E\u0561\u0580\u057E\u056B \u056F\u056B\u0580\u0561\u057C\u0565\u056C\u056B \u0585\u0580\u0565\u0576\u0584\u0576\u0565\u0580\u0578\u057E\u055D \u0561\u057C\u0561\u0576\u0581 \u0585\u0580\u0565\u0576\u0584\u0576\u0565\u0580\u056B \u056F\u0578\u056C\u056B\u0566\u056B\u0561\u0575\u056B \u0564\u0580\u0578\u0582\u0575\u0569\u0576\u0565\u0580\u056B \u0570\u0561\u0577\u057E\u056B \u0561\u057C\u0576\u0574\u0561\u0576:</p>`,
}
