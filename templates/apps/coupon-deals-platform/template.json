{
  "label": "Coupon/Deals Platform",
  "description": "Groupon-like deals platform with merchant offers, expiry tracking, redemption codes, and QR verification — with built-in Stripe-backed subscription tiers",
  "cluster": "ecommerce",
  "type": "full-stack",
  "framework": "react",
  "packages": [
    "@molecule/api-database-postgresql",
    "@molecule/api-resource-user",
    "@molecule/api-search-meilisearch",
    "@molecule/api-payments-stripe",
    "@molecule/api-geolocation-google",
    "@molecule/api-emails-mailgun",
    "@molecule/api-image-sharp",
    "@molecule/api-uploads-s3",
    "@molecule/api-cron-node-cron",
    "@molecule/app-data-table",
    "@molecule/app-virtual-scroll",
    "@molecule/app-maps",
    "@molecule/api-resource-payment",
    "@molecule/api-entitlements",
    "@molecule/api-email-templates",
    "@molecule/app-billing-react",
    "@molecule/app-sidebar-layout-react",
    "@molecule/app-notification-feed-react"
  ],
  "env": {
    "APP_NAME": {
      "description": "Platform name displayed in header and emails",
      "default": "Snagr"
    },
    "DATABASE_URL": {
      "description": "PostgreSQL connection string",
      "required": true
    },
    "STRIPE_SECRET_KEY": {
      "description": "Stripe secret API key for payment processing",
      "required": true
    },
    "STRIPE_PUBLISHABLE_KEY": {
      "description": "Stripe publishable key for client-side checkout",
      "required": true
    },
    "STRIPE_WEBHOOK_SECRET": {
      "description": "Stripe webhook signing secret",
      "required": true
    },
    "MEILISEARCH_HOST": {
      "description": "MeiliSearch server URL",
      "default": "http://localhost:7700"
    },
    "MEILISEARCH_API_KEY": {
      "description": "MeiliSearch admin API key",
      "required": true
    },
    "GOOGLE_MAPS_API_KEY": {
      "description": "Google Maps API key for location-based deals",
      "required": true
    },
    "S3_BUCKET": {
      "description": "S3 bucket for deal images",
      "required": true
    },
    "S3_REGION": {
      "description": "AWS region for S3 bucket",
      "default": "us-east-1"
    },
    "AWS_ACCESS_KEY_ID": {
      "description": "AWS access key for S3",
      "required": true
    },
    "AWS_SECRET_ACCESS_KEY": {
      "description": "AWS secret key for S3",
      "required": true
    },
    "MAILGUN_API_KEY": {
      "description": "Mailgun API key for transactional emails",
      "required": true
    },
    "MAILGUN_DOMAIN": {
      "description": "Mailgun sending domain",
      "required": true
    },
    "PLATFORM_COMMISSION_RATE": {
      "description": "Platform commission rate as decimal",
      "default": "0.15"
    },
    "DEFAULT_CURRENCY": {
      "description": "Default currency code",
      "default": "USD"
    },
    "STRIPE_COUPON_DEALS_PLATFORM_PRO_MONTHLY": {
      "description": "Stripe price ID for the Pro Monthly plan",
      "required": false
    },
    "STRIPE_COUPON_DEALS_PLATFORM_PRO_YEARLY": {
      "description": "Stripe price ID for the Pro Yearly plan",
      "required": false
    },
    "STRIPE_COUPON_DEALS_PLATFORM_TEAM_MONTHLY": {
      "description": "Stripe price ID for the Team Monthly plan",
      "required": false
    },
    "STRIPE_COUPON_DEALS_PLATFORM_TEAM_YEARLY": {
      "description": "Stripe price ID for the Team Yearly plan",
      "required": false
    }
  },
  "layout": "dashboard",
  "features": [
    "auth",
    "search",
    "payments",
    "notifications",
    "image-upload",
    "geolocation",
    "cron",
    "subscriptions"
  ]
}
