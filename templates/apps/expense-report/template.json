{
  "label": "Expense Report",
  "description": "Expensify-like expense management with receipts, approval workflow, policies, and reimbursement tracking — with built-in Stripe-backed subscription tiers",
  "cluster": "finance",
  "type": "full-stack",
  "framework": "react",
  "packages": [
    "@molecule/api-database-postgresql",
    "@molecule/api-resource-user",
    "@molecule/api-uploads-s3",
    "@molecule/api-workflow-database",
    "@molecule/api-permissions-custom",
    "@molecule/api-emails-mailgun",
    "@molecule/api-reporting-database",
    "@molecule/api-import-export-csv",
    "@molecule/api-image-sharp",
    "@molecule/app-data-table",
    "@molecule/app-file-upload",
    "@molecule/app-date-range-picker",
    "@molecule/api-resource-payment",
    "@molecule/api-payments-stripe",
    "@molecule/api-entitlements",
    "@molecule/api-email-templates",
    "@molecule/app-billing-react"
  ],
  "env": {
    "APP_NAME": {
      "description": "Application name",
      "default": "Expense Report"
    },
    "DATABASE_URL": {
      "description": "PostgreSQL connection string",
      "required": true
    },
    "S3_BUCKET": {
      "description": "S3 bucket for receipt uploads",
      "required": true
    },
    "MAILGUN_API_KEY": {
      "description": "Mailgun API key for approval notifications",
      "required": true
    },
    "STRIPE_SECRET_KEY": {
      "description": "Stripe secret API key (sk_test_... in test mode)",
      "required": true
    },
    "STRIPE_WEBHOOK_SECRET": {
      "description": "Stripe webhook signing secret (whsec_...)",
      "required": true
    },
    "STRIPE_EXPENSE_REPORT_PRO_MONTHLY": {
      "description": "Stripe price ID for the Pro Monthly plan",
      "required": false
    },
    "STRIPE_EXPENSE_REPORT_PRO_YEARLY": {
      "description": "Stripe price ID for the Pro Yearly plan",
      "required": false
    },
    "STRIPE_EXPENSE_REPORT_TEAM_MONTHLY": {
      "description": "Stripe price ID for the Team Monthly plan",
      "required": false
    },
    "STRIPE_EXPENSE_REPORT_TEAM_YEARLY": {
      "description": "Stripe price ID for the Team Yearly plan",
      "required": false
    },
    "MAILGUN_DOMAIN": {
      "description": "Mailgun sending domain",
      "required": false
    }
  },
  "layout": "dashboard",
  "features": [
    "auth",
    "file-upload",
    "workflow",
    "reports",
    "import-export",
    "subscriptions"
  ]
}
