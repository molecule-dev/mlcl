{
  "label": "Language Learning",
  "description": "Duolingo-like language learning app with lessons, exercises, streaks, and XP — with built-in Stripe-backed subscription tiers",
  "cluster": "education",
  "type": "full-stack",
  "framework": "react",
  "packages": [
    "@molecule/api-database-postgresql",
    "@molecule/api-resource-user",
    "@molecule/api-resource-activity-feed",
    "@molecule/api-resource-follow",
    "@molecule/api-cron-node-cron",
    "@molecule/api-reporting-database",
    "@molecule/api-push-notifications-web-push",
    "@molecule/api-ai-speech-openai",
    "@molecule/api-image-sharp",
    "@molecule/api-uploads-s3",
    "@molecule/app-data-table",
    "@molecule/app-virtual-scroll",
    "@molecule/app-command-palette",
    "@molecule/api-resource-payment",
    "@molecule/api-payments-stripe",
    "@molecule/api-entitlements",
    "@molecule/api-email-templates",
    "@molecule/api-emails-mailgun",
    "@molecule/app-billing-react"
  ],
  "env": {
    "APP_NAME": {
      "description": "Application name",
      "default": "Language Learning"
    },
    "DATABASE_URL": {
      "description": "PostgreSQL connection string",
      "required": true
    },
    "OPENAI_API_KEY": {
      "description": "OpenAI API key for speech",
      "required": true
    },
    "S3_BUCKET": {
      "description": "S3 bucket for audio assets",
      "required": true
    },
    "S3_REGION": {
      "description": "S3 region",
      "default": "us-east-1"
    },
    "STRIPE_SECRET_KEY": {
      "description": "Stripe secret API key (sk_test_... in test mode)",
      "required": true
    },
    "STRIPE_WEBHOOK_SECRET": {
      "description": "Stripe webhook signing secret (whsec_...)",
      "required": true
    },
    "STRIPE_LANGUAGE_LEARNING_PRO_MONTHLY": {
      "description": "Stripe price ID for the Pro Monthly plan",
      "required": false
    },
    "STRIPE_LANGUAGE_LEARNING_PRO_YEARLY": {
      "description": "Stripe price ID for the Pro Yearly plan",
      "required": false
    },
    "STRIPE_LANGUAGE_LEARNING_TEAM_MONTHLY": {
      "description": "Stripe price ID for the Team Monthly plan",
      "required": false
    },
    "STRIPE_LANGUAGE_LEARNING_TEAM_YEARLY": {
      "description": "Stripe price ID for the Team Yearly plan",
      "required": false
    },
    "MAILGUN_API_KEY": {
      "description": "Mailgun API key for transactional emails",
      "required": false
    },
    "MAILGUN_DOMAIN": {
      "description": "Mailgun sending domain",
      "required": false
    }
  },
  "layout": "dashboard",
  "features": [
    "auth",
    "notifications",
    "speech",
    "subscriptions"
  ]
}
