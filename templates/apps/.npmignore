# prepack records these files in each flagship's locales.json.br. Keep English
# and root locale modules readable; copyTemplateInstance restores the other files.
*/app/src/locales/*/
!*/app/src/locales/en/

# Each workspace's ESLint config is a byte copy of templates/shared/eslint.config.js.tpl
# (the workspace's sync-eslint-rules), and copyTemplateInstance writes that template into
# every api/ and app/ (scaffoldEslint in src/lib/scaffold.ts). Ship it once instead of
# hundreds of copies; the pack check refuses any copy.
*/api/eslint.config.js
*/app/eslint.config.js
