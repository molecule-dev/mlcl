{
  "label": "AI Data Analyst",
  "description": "Upload data, ask questions in natural language, and get charts and insights — with built-in Stripe-backed subscription tiers",
  "cluster": "ai-first",
  "type": "full-stack",
  "framework": "react",
  "packages": [
    "@molecule/api-database-postgresql",
    "@molecule/api-resource-user",
    "@molecule/api-ai-anthropic",
    "@molecule/api-ai-rag",
    "@molecule/api-ai-rag-llm",
    "@molecule/api-ai-embeddings-openai",
    "@molecule/api-ai-vector-store-pgvector",
    "@molecule/api-uploads-s3",
    "@molecule/api-import-export-csv",
    "@molecule/app-charts",
    "@molecule/app-data-table",
    "@molecule/app-file-upload",
    "@molecule/app-ai-assistant",
    "@molecule/api-resource-payment",
    "@molecule/api-payments-stripe",
    "@molecule/api-entitlements",
    "@molecule/api-email-templates",
    "@molecule/api-emails-mailgun",
    "@molecule/app-billing-react",
    "@molecule/app-sidebar-layout-react",
    "@molecule/app-notification-feed-react"
  ],
  "env": {
    "APP_NAME": {
      "description": "Application name",
      "default": "AI Data Analyst"
    },
    "DATABASE_URL": {
      "description": "PostgreSQL connection string",
      "required": true
    },
    "ANTHROPIC_API_KEY": {
      "description": "Anthropic API key for Claude",
      "required": true
    },
    "OPENAI_API_KEY": {
      "description": "OpenAI API key for embeddings",
      "required": true
    },
    "AWS_ACCESS_KEY_ID": {
      "description": "AWS access key for S3 uploads",
      "required": true
    },
    "AWS_SECRET_ACCESS_KEY": {
      "description": "AWS secret key for S3 uploads",
      "required": true
    },
    "S3_BUCKET": {
      "description": "S3 bucket name for data file storage",
      "required": true
    },
    "STRIPE_SECRET_KEY": {
      "description": "Stripe secret API key (sk_test_... in test mode)",
      "required": true
    },
    "STRIPE_WEBHOOK_SECRET": {
      "description": "Stripe webhook signing secret (whsec_...)",
      "required": true
    },
    "STRIPE_AI_DATA_ANALYST_PRO_MONTHLY": {
      "description": "Stripe price ID for the Pro Monthly plan",
      "required": false
    },
    "STRIPE_AI_DATA_ANALYST_PRO_YEARLY": {
      "description": "Stripe price ID for the Pro Yearly plan",
      "required": false
    },
    "STRIPE_AI_DATA_ANALYST_TEAM_MONTHLY": {
      "description": "Stripe price ID for the Team Monthly plan",
      "required": false
    },
    "STRIPE_AI_DATA_ANALYST_TEAM_YEARLY": {
      "description": "Stripe price ID for the Team Yearly plan",
      "required": false
    },
    "MAILGUN_API_KEY": {
      "description": "Mailgun API key for transactional emails",
      "required": false
    },
    "MAILGUN_DOMAIN": {
      "description": "Mailgun sending domain",
      "required": false
    }
  },
  "layout": "dashboard",
  "features": [
    "auth",
    "data-upload",
    "ai-analysis",
    "charts",
    "data-table",
    "export",
    "subscriptions"
  ]
}
