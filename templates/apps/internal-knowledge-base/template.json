{
  "label": "Internal Knowledge Base",
  "description": "Confluence-like knowledge base with articles, spaces, search, and permissions — with built-in Stripe-backed subscription tiers",
  "cluster": "business-saas",
  "type": "full-stack",
  "framework": "react",
  "packages": [
    "@molecule/api-database-postgresql",
    "@molecule/api-resource-user",
    "@molecule/api-resource-comment",
    "@molecule/api-resource-tag",
    "@molecule/api-resource-reaction",
    "@molecule/api-resource-bookmark",
    "@molecule/api-permissions-custom",
    "@molecule/api-search-meilisearch",
    "@molecule/api-uploads-s3",
    "@molecule/api-ai-summarization",
    "@molecule/app-markdown",
    "@molecule/app-tree-view",
    "@molecule/app-data-table",
    "@molecule/app-command-palette",
    "@molecule/app-keyboard-shortcuts",
    "@molecule/api-resource-payment",
    "@molecule/api-payments-stripe",
    "@molecule/api-entitlements",
    "@molecule/api-email-templates",
    "@molecule/api-emails-mailgun",
    "@molecule/app-billing-react"
  ],
  "env": {
    "APP_NAME": {
      "description": "Application name",
      "default": "Knowledge Base"
    },
    "DATABASE_URL": {
      "description": "PostgreSQL connection string",
      "required": true
    },
    "MEILISEARCH_HOST": {
      "description": "MeiliSearch server URL",
      "default": "http://localhost:7700"
    },
    "MEILISEARCH_API_KEY": {
      "description": "MeiliSearch API key",
      "required": true
    },
    "S3_BUCKET": {
      "description": "S3 bucket for attachments",
      "required": true
    },
    "S3_REGION": {
      "description": "S3 region",
      "default": "us-east-1"
    },
    "STRIPE_SECRET_KEY": {
      "description": "Stripe secret API key (sk_test_... in test mode)",
      "required": true
    },
    "STRIPE_WEBHOOK_SECRET": {
      "description": "Stripe webhook signing secret (whsec_...)",
      "required": true
    },
    "STRIPE_INTERNAL_KNOWLEDGE_BASE_PRO_MONTHLY": {
      "description": "Stripe price ID for the Pro Monthly plan",
      "required": false
    },
    "STRIPE_INTERNAL_KNOWLEDGE_BASE_PRO_YEARLY": {
      "description": "Stripe price ID for the Pro Yearly plan",
      "required": false
    },
    "STRIPE_INTERNAL_KNOWLEDGE_BASE_TEAM_MONTHLY": {
      "description": "Stripe price ID for the Team Monthly plan",
      "required": false
    },
    "STRIPE_INTERNAL_KNOWLEDGE_BASE_TEAM_YEARLY": {
      "description": "Stripe price ID for the Team Yearly plan",
      "required": false
    },
    "MAILGUN_API_KEY": {
      "description": "Mailgun API key for transactional emails",
      "required": false
    },
    "MAILGUN_DOMAIN": {
      "description": "Mailgun sending domain",
      "required": false
    }
  },
  "layout": "dashboard",
  "features": [
    "auth",
    "search",
    "articles",
    "spaces",
    "permissions",
    "bookmarks",
    "comments",
    "subscriptions"
  ]
}
