{
  "label": "Note-taking",
  "description": "Notion-like note-taking with block editor, nested pages, databases, and templates — with built-in Stripe-backed subscription tiers",
  "cluster": "productivity",
  "type": "full-stack",
  "framework": "react",
  "packages": [
    "@molecule/api-database-postgresql",
    "@molecule/api-resource-user",
    "@molecule/api-resource-tag",
    "@molecule/api-resource-comment",
    "@molecule/api-resource-bookmark",
    "@molecule/api-resource-activity-feed",
    "@molecule/api-search-meilisearch",
    "@molecule/api-permissions-custom",
    "@molecule/api-uploads-s3",
    "@molecule/api-image-sharp",
    "@molecule/api-realtime-socketio",
    "@molecule/api-ai-summarization",
    "@molecule/api-import-export-csv",
    "@molecule/api-pdf-pdfkit",
    "@molecule/app-rich-text-quill",
    "@molecule/app-markdown-react-markdown",
    "@molecule/app-tree-view-default",
    "@molecule/app-drag-drop-dndkit",
    "@molecule/app-keyboard-shortcuts-hotkeys",
    "@molecule/app-command-palette-cmdk",
    "@molecule/app-virtual-scroll-tanstack",
    "@molecule/app-file-upload-filepond",
    "@molecule/app-realtime-socketio",
    "@molecule/app-ai-copilot-default",
    "@molecule/api-resource-payment",
    "@molecule/api-payments-stripe",
    "@molecule/api-entitlements",
    "@molecule/api-email-templates",
    "@molecule/api-emails-mailgun",
    "@molecule/app-billing-react"
  ],
  "env": {
    "APP_NAME": {
      "description": "Application name",
      "default": "Notes"
    },
    "DATABASE_URL": {
      "description": "PostgreSQL connection string",
      "required": true
    },
    "MEILISEARCH_HOST": {
      "description": "MeiliSearch server URL",
      "default": "http://localhost:7700"
    },
    "MEILISEARCH_API_KEY": {
      "description": "MeiliSearch API key",
      "required": true
    },
    "S3_BUCKET": {
      "description": "S3 bucket for file uploads",
      "required": true
    },
    "S3_REGION": {
      "description": "S3 region",
      "default": "us-east-1"
    },
    "STRIPE_SECRET_KEY": {
      "description": "Stripe secret API key (sk_test_... in test mode)",
      "required": true
    },
    "STRIPE_WEBHOOK_SECRET": {
      "description": "Stripe webhook signing secret (whsec_...)",
      "required": true
    },
    "STRIPE_NOTE_TAKING_PRO_MONTHLY": {
      "description": "Stripe price ID for the Pro Monthly plan",
      "required": false
    },
    "STRIPE_NOTE_TAKING_PRO_YEARLY": {
      "description": "Stripe price ID for the Pro Yearly plan",
      "required": false
    },
    "STRIPE_NOTE_TAKING_TEAM_MONTHLY": {
      "description": "Stripe price ID for the Team Monthly plan",
      "required": false
    },
    "STRIPE_NOTE_TAKING_TEAM_YEARLY": {
      "description": "Stripe price ID for the Team Yearly plan",
      "required": false
    },
    "MAILGUN_API_KEY": {
      "description": "Mailgun API key for transactional emails",
      "required": false
    },
    "MAILGUN_DOMAIN": {
      "description": "Mailgun sending domain",
      "required": false
    }
  },
  "layout": "dashboard",
  "features": [
    "auth",
    "search",
    "realtime",
    "rich-text",
    "nested-pages",
    "templates",
    "subscriptions"
  ]
}
