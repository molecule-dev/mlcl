{
  "label": "AI Chatbot Builder",
  "description": "Botpress-like chatbot builder with conversation flows, intents, training data, and deployment — including a built-in subscription tier (Free / Pro / Team) backed by Stripe",
  "cluster": "operations-iot",
  "type": "full-stack",
  "framework": "react",
  "packages": [
    "@molecule/api-database-postgresql",
    "@molecule/api-resource-user",
    "@molecule/api-resource-payment",
    "@molecule/api-ai-anthropic",
    "@molecule/api-ai-openai",
    "@molecule/api-ai-agents",
    "@molecule/api-ai-agents-llm",
    "@molecule/api-ai-rag",
    "@molecule/api-ai-rag-llm",
    "@molecule/api-ai-embeddings-openai",
    "@molecule/api-ai-vector-store-pgvector",
    "@molecule/api-resource-thread",
    "@molecule/api-search-meilisearch",
    "@molecule/api-payments-stripe",
    "@molecule/api-entitlements",
    "@molecule/api-email-templates",
    "@molecule/api-emails-mailgun",
    "@molecule/app-ai-assistant",
    "@molecule/app-ai-copilot",
    "@molecule/app-data-table",
    "@molecule/app-command-palette",
    "@molecule/app-billing-react",
    "@molecule/app-kpi-card-react"
  ],
  "env": {
    "APP_NAME": {
      "description": "Application name",
      "default": "Chatbot Builder"
    },
    "DATABASE_URL": {
      "description": "PostgreSQL connection string",
      "required": true
    },
    "ANTHROPIC_API_KEY": {
      "description": "Anthropic API key",
      "required": true
    },
    "OPENAI_API_KEY": {
      "description": "OpenAI API key for embeddings",
      "required": true
    },
    "MEILISEARCH_HOST": {
      "description": "MeiliSearch server URL",
      "default": "http://localhost:7700"
    },
    "MEILISEARCH_API_KEY": {
      "description": "MeiliSearch API key",
      "required": true
    },
    "STRIPE_SECRET_KEY": {
      "description": "Stripe secret API key (sk_test_... in test mode)",
      "required": true
    },
    "STRIPE_WEBHOOK_SECRET": {
      "description": "Stripe webhook signing secret (whsec_...)",
      "required": true
    },
    "STRIPE_AI_CHATBOT_BUILDER_PRO_MONTHLY": {
      "description": "Stripe price ID for the Pro Monthly plan",
      "required": false
    },
    "STRIPE_AI_CHATBOT_BUILDER_PRO_YEARLY": {
      "description": "Stripe price ID for the Pro Yearly plan",
      "required": false
    },
    "STRIPE_AI_CHATBOT_BUILDER_TEAM_MONTHLY": {
      "description": "Stripe price ID for the Team Monthly plan",
      "required": false
    },
    "STRIPE_AI_CHATBOT_BUILDER_TEAM_YEARLY": {
      "description": "Stripe price ID for the Team Yearly plan",
      "required": false
    },
    "MAILGUN_API_KEY": {
      "description": "Mailgun API key for transactional emails",
      "required": false
    },
    "MAILGUN_DOMAIN": {
      "description": "Mailgun sending domain",
      "required": false
    }
  },
  "layout": "admin",
  "features": [
    "auth",
    "search",
    "ai",
    "rag",
    "embeddings",
    "conversation-flows",
    "subscriptions"
  ]
}
