{
  "name": "static-site-thin-app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "tsx scripts/build.ts",
    "preview": "tsx scripts/preview.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:changed": "playwright test --only-changed --list && playwright test --only-changed",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ scripts/",
    "lint:fix": "eslint src/ scripts/ --fix",
    "format": "prettier --write 'src/**/*.ts' 'scripts/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'scripts/**/*.ts'"
  },
  "dependencies": {
    "@molecule/api-agent-transcript": "1.0.2",
    "@molecule/api-agent-transcript-autodetect": "1.2.7",
    "@molecule/api-ai": "1.6.2",
    "@molecule/api-ai-deepseek": "1.2.5",
    "@molecule/api-ai-summarization": "1.1.1",
    "@molecule/api-ai-summarization-llm": "1.1.4",
    "@molecule/api-bond": "1.0.5",
    "@molecule/api-content": "1.0.5",
    "@molecule/api-content-markdown": "1.0.3",
    "@molecule/api-feed-rss": "1.0.4",
    "@molecule/api-i18n": "1.0.6",
    "@molecule/api-sitemap": "1.0.4",
    "@molecule/api-sitemap-xml": "1.0.3",
    "@molecule/api-text-provenance": "1.0.3",
    "@molecule/api-text-provenance-overlap": "1.0.2",
    "@molecule/app-bond": "1.0.5",
    "@molecule/app-i18n": "1.3.0",
    "@molecule/app-logger": "1.1.0",
    "@molecule/app-margin-notes-html": "1.0.10",
    "@molecule/app-markdown": "1.1.0",
    "@molecule/app-markdown-marked": "1.1.0"
  },
  "devDependencies": {
    "@molecule/app-e2e": "1.3.0",
    "@molecule/app-e2e-fixtures-default": "1.2.8",
    "@molecule/app-e2e-playwright": "1.1.1",
    "@molecule/app-e2e-preview": "1.1.0",
    "@molecule/eslint-config": "1.2.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "eslint": "10.15.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "molecule": {
    "projectType": "static",
    "framework": "none",
    "devServer": "script",
    "suppliedStylesheet": "public/supplied-styles/entry.css"
  }
}
