{
  "name": "static-site-thin-app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "tsx scripts/build.ts",
    "preview": "tsx scripts/preview.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:changed": "playwright test --only-changed --list && playwright test --only-changed",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ scripts/",
    "lint:fix": "eslint src/ scripts/ --fix",
    "format": "prettier --write 'src/**/*.ts' 'scripts/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'scripts/**/*.ts'"
  },
  "dependencies": {
    "@molecule/api-agent-transcript": "1.0.1",
    "@molecule/api-agent-transcript-autodetect": "1.2.3",
    "@molecule/api-ai": "1.3.4",
    "@molecule/api-ai-deepseek": "1.0.11",
    "@molecule/api-ai-summarization": "1.1.0",
    "@molecule/api-ai-summarization-llm": "1.1.1",
    "@molecule/api-bond": "1.0.2",
    "@molecule/api-content": "1.0.3",
    "@molecule/api-content-markdown": "1.0.2",
    "@molecule/api-feed-rss": "1.0.2",
    "@molecule/api-i18n": "1.0.3",
    "@molecule/api-sitemap": "1.0.3",
    "@molecule/api-sitemap-xml": "1.0.2",
    "@molecule/api-text-provenance": "1.0.2",
    "@molecule/api-text-provenance-overlap": "1.0.1",
    "@molecule/app-bond": "1.0.3",
    "@molecule/app-i18n": "1.0.3",
    "@molecule/app-logger": "1.0.2",
    "@molecule/app-margin-notes-html": "1.0.8",
    "@molecule/app-markdown": "1.0.2",
    "@molecule/app-markdown-marked": "1.0.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@molecule/app-e2e": "1.2.2",
    "@molecule/app-e2e-fixtures-default": "1.2.2",
    "@molecule/app-e2e-playwright": "1.0.2",
    "@molecule/app-e2e-preview": "1.0.10",
    "@playwright/test": "1.63.0",
    "@types/node": "26.1.2",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.12"
  },
  "molecule": {
    "projectType": "static",
    "framework": "none",
    "devServer": "script"
  }
}
