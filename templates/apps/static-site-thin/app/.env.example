# The variables `npm run build` and `npm run dev` read from the ENVIRONMENT.
# This file is a list of them, not something the build loads: set them in the
# shell (BASE_PATH=/blog SITE_URL=https://example.com npm run build) or, on
# molecule.dev, in the project's Environment settings.
# The sub-path the site lives under: / for the origin root, /blog for example.com/blog/
BASE_PATH=/
# The site's canonical origin, for the absolute URLs in the feeds, sitemap and
# llms.txt. It may differ from where a deploy is served (see src/config.ts).
SITE_URL=http://localhost:3000
