{
  "label": "Food Delivery",
  "description": "DoorDash-like food delivery platform with restaurant menus, ordering, driver tracking, and real-time ETA \u2014 with built-in Stripe-backed subscription tiers",
  "cluster": "ecommerce",
  "type": "full-stack",
  "framework": "react",
  "packages": [
    "@molecule/api-database-postgresql",
    "@molecule/api-email-templates",
    "@molecule/api-emails-mailgun",
    "@molecule/api-entitlements",
    "@molecule/api-geolocation-google",
    "@molecule/api-image-sharp",
    "@molecule/api-payments-stripe",
    "@molecule/api-push-notifications-web-push",
    "@molecule/api-realtime-socketio",
    "@molecule/api-resource-order",
    "@molecule/api-resource-payment",
    "@molecule/api-resource-user",
    "@molecule/api-search-meilisearch",
    "@molecule/api-uploads-s3",
    "@molecule/app-billing-react",
    "@molecule/app-data-table",
    "@molecule/app-maps",
    "@molecule/app-notification-feed-react",
    "@molecule/app-realtime-socketio",
    "@molecule/app-status-timeline-react",
    "@molecule/app-top-nav-layout-react",
    "@molecule/app-virtual-scroll"
  ],
  "env": {
    "APP_NAME": {
      "description": "Platform name displayed in header and emails",
      "default": "My Eats"
    },
    "DATABASE_URL": {
      "description": "PostgreSQL connection string",
      "required": true
    },
    "STRIPE_SECRET_KEY": {
      "description": "Stripe secret API key for payment processing",
      "required": true
    },
    "STRIPE_PUBLISHABLE_KEY": {
      "description": "Stripe publishable key for client-side checkout",
      "required": true
    },
    "STRIPE_WEBHOOK_SECRET": {
      "description": "Stripe webhook signing secret",
      "required": true
    },
    "MEILISEARCH_HOST": {
      "description": "MeiliSearch server URL",
      "default": "http://localhost:7700"
    },
    "MEILISEARCH_API_KEY": {
      "description": "MeiliSearch admin API key",
      "required": true
    },
    "GOOGLE_MAPS_API_KEY": {
      "description": "Google Maps API key for geocoding and distance calculations",
      "required": true
    },
    "S3_BUCKET": {
      "description": "S3 bucket for restaurant and menu images",
      "required": true
    },
    "S3_REGION": {
      "description": "AWS region for S3 bucket",
      "default": "us-east-1"
    },
    "AWS_ACCESS_KEY_ID": {
      "description": "AWS access key for S3",
      "required": true
    },
    "AWS_SECRET_ACCESS_KEY": {
      "description": "AWS secret key for S3",
      "required": true
    },
    "MAILGUN_API_KEY": {
      "description": "Mailgun API key for transactional emails",
      "required": true
    },
    "MAILGUN_DOMAIN": {
      "description": "Mailgun sending domain",
      "required": true
    },
    "DELIVERY_RADIUS_KM": {
      "description": "Maximum delivery radius in kilometers",
      "default": "15"
    },
    "DELIVERY_FEE_BASE": {
      "description": "Base delivery fee in cents",
      "default": "299"
    },
    "DELIVERY_FEE_PER_KM": {
      "description": "Additional delivery fee per km in cents",
      "default": "50"
    },
    "SERVICE_FEE_PERCENT": {
      "description": "Service fee as decimal",
      "default": "0.15"
    },
    "DEFAULT_CURRENCY": {
      "description": "Default currency code",
      "default": "USD"
    },
    "STRIPE_FOOD_DELIVERY_PRO_MONTHLY": {
      "description": "Stripe price ID for the Pro Monthly plan",
      "required": false
    },
    "STRIPE_FOOD_DELIVERY_PRO_YEARLY": {
      "description": "Stripe price ID for the Pro Yearly plan",
      "required": false
    },
    "STRIPE_FOOD_DELIVERY_TEAM_MONTHLY": {
      "description": "Stripe price ID for the Team Monthly plan",
      "required": false
    },
    "STRIPE_FOOD_DELIVERY_TEAM_YEARLY": {
      "description": "Stripe price ID for the Team Yearly plan",
      "required": false
    }
  },
  "layout": "dashboard",
  "features": [
    "auth",
    "search",
    "payments",
    "notifications",
    "realtime",
    "geolocation",
    "image-upload",
    "push-notifications",
    "subscriptions"
  ]
}
