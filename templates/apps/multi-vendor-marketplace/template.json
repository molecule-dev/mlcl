{
  "label": "Multi-vendor Marketplace",
  "description": "Etsy-like marketplace with vendor management, commissions, and payouts — with built-in Stripe-backed subscription tiers",
  "cluster": "ecommerce",
  "type": "full-stack",
  "framework": "react",
  "packages": [
    "@molecule/api-database-postgresql",
    "@molecule/api-resource-user",
    "@molecule/api-resource-product",
    "@molecule/api-resource-cart",
    "@molecule/api-resource-order",
    "@molecule/api-resource-inventory",
    "@molecule/api-resource-review",
    "@molecule/api-payments-stripe",
    "@molecule/api-search-meilisearch",
    "@molecule/api-permissions-custom",
    "@molecule/api-image-sharp",
    "@molecule/api-uploads-s3",
    "@molecule/api-emails-mailgun",
    "@molecule/app-data-table",
    "@molecule/app-gallery",
    "@molecule/api-resource-payment",
    "@molecule/api-entitlements",
    "@molecule/api-email-templates",
    "@molecule/app-billing-react"
  ],
  "env": {
    "APP_NAME": {
      "description": "Marketplace name",
      "default": "My Marketplace"
    },
    "DATABASE_URL": {
      "description": "PostgreSQL connection string",
      "required": true
    },
    "STRIPE_SECRET_KEY": {
      "description": "Stripe secret API key",
      "required": true
    },
    "STRIPE_PUBLISHABLE_KEY": {
      "description": "Stripe publishable key",
      "required": true
    },
    "STRIPE_WEBHOOK_SECRET": {
      "description": "Stripe webhook signing secret",
      "required": true
    },
    "MEILISEARCH_HOST": {
      "description": "MeiliSearch server URL",
      "default": "http://localhost:7700"
    },
    "MEILISEARCH_API_KEY": {
      "description": "MeiliSearch admin API key",
      "required": true
    },
    "S3_BUCKET": {
      "description": "S3 bucket for product images",
      "required": true
    },
    "S3_REGION": {
      "description": "AWS region",
      "default": "us-east-1"
    },
    "AWS_ACCESS_KEY_ID": {
      "description": "AWS access key for S3",
      "required": true
    },
    "AWS_SECRET_ACCESS_KEY": {
      "description": "AWS secret key for S3",
      "required": true
    },
    "MAILGUN_API_KEY": {
      "description": "Mailgun API key",
      "required": true
    },
    "MAILGUN_DOMAIN": {
      "description": "Mailgun sending domain",
      "required": true
    },
    "MARKETPLACE_COMMISSION_RATE": {
      "description": "Platform commission rate as decimal",
      "default": "0.08"
    },
    "MARKETPLACE_CURRENCY": {
      "description": "Default currency code",
      "default": "USD"
    },
    "STRIPE_MULTI_VENDOR_MARKETPLACE_PRO_MONTHLY": {
      "description": "Stripe price ID for the Pro Monthly plan",
      "required": false
    },
    "STRIPE_MULTI_VENDOR_MARKETPLACE_PRO_YEARLY": {
      "description": "Stripe price ID for the Pro Yearly plan",
      "required": false
    },
    "STRIPE_MULTI_VENDOR_MARKETPLACE_TEAM_MONTHLY": {
      "description": "Stripe price ID for the Team Monthly plan",
      "required": false
    },
    "STRIPE_MULTI_VENDOR_MARKETPLACE_TEAM_YEARLY": {
      "description": "Stripe price ID for the Team Yearly plan",
      "required": false
    }
  },
  "layout": "dashboard",
  "features": [
    "auth",
    "search",
    "payments",
    "notifications",
    "image-upload",
    "permissions",
    "subscriptions"
  ]
}
