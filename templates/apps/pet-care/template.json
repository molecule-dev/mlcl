{
  "label": "Pet Care",
  "description": "Rover-like pet care platform with pet profiles, vet records, sitter bookings, and health tracking — with built-in Stripe-backed subscription tiers",
  "cluster": "operations-iot",
  "type": "full-stack",
  "framework": "react",
  "packages": [
    "@molecule/api-database-postgresql",
    "@molecule/api-resource-user",
    "@molecule/api-resource-booking",
    "@molecule/api-uploads-s3",
    "@molecule/api-image-sharp",
    "@molecule/api-emails-mailgun",
    "@molecule/api-search-meilisearch",
    "@molecule/api-cron-node-cron",
    "@molecule/app-data-table",
    "@molecule/app-calendar",
    "@molecule/app-file-upload",
    "@molecule/app-gallery",
    "@molecule/app-command-palette",
    "@molecule/api-resource-payment",
    "@molecule/api-payments-stripe",
    "@molecule/api-entitlements",
    "@molecule/api-email-templates",
    "@molecule/app-billing-react"
  ],
  "env": {
    "APP_NAME": {
      "description": "Application name",
      "default": "Pet Care"
    },
    "DATABASE_URL": {
      "description": "PostgreSQL connection string",
      "required": true
    },
    "MEILISEARCH_HOST": {
      "description": "MeiliSearch server URL",
      "default": "http://localhost:7700"
    },
    "MEILISEARCH_API_KEY": {
      "description": "MeiliSearch API key",
      "required": true
    },
    "AWS_S3_BUCKET": {
      "description": "S3 bucket for pet photos",
      "required": true
    },
    "AWS_ACCESS_KEY_ID": {
      "description": "AWS access key",
      "required": true
    },
    "AWS_SECRET_ACCESS_KEY": {
      "description": "AWS secret key",
      "required": true
    },
    "MAILGUN_API_KEY": {
      "description": "Mailgun API key for booking notifications",
      "required": true
    },
    "MAILGUN_DOMAIN": {
      "description": "Mailgun sending domain",
      "required": true
    },
    "STRIPE_SECRET_KEY": {
      "description": "Stripe secret API key (sk_test_... in test mode)",
      "required": true
    },
    "STRIPE_WEBHOOK_SECRET": {
      "description": "Stripe webhook signing secret (whsec_...)",
      "required": true
    },
    "STRIPE_PET_CARE_PRO_MONTHLY": {
      "description": "Stripe price ID for the Pro Monthly plan",
      "required": false
    },
    "STRIPE_PET_CARE_PRO_YEARLY": {
      "description": "Stripe price ID for the Pro Yearly plan",
      "required": false
    },
    "STRIPE_PET_CARE_TEAM_MONTHLY": {
      "description": "Stripe price ID for the Team Monthly plan",
      "required": false
    },
    "STRIPE_PET_CARE_TEAM_YEARLY": {
      "description": "Stripe price ID for the Team Yearly plan",
      "required": false
    }
  },
  "layout": "dashboard",
  "features": [
    "auth",
    "search",
    "upload",
    "calendar",
    "gallery",
    "notifications",
    "subscriptions"
  ]
}
