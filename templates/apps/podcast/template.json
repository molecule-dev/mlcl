{
  "label": "Podcast Platform",
  "description": "Podcast hosting with audio player, episodes, RSS, and subscriptions",
  "cluster": "content-social",
  "type": "full-stack",
  "framework": "react",
  "packages": [
    "@molecule/api-database-postgresql",
    "@molecule/api-resource-user",
    "@molecule/api-search-meilisearch",
    "@molecule/api-resource-comment",
    "@molecule/api-resource-reaction",
    "@molecule/api-resource-follow",
    "@molecule/api-uploads-s3",
    "@molecule/api-sitemap-xml",
    "@molecule/api-ai-speech-openai",
    "@molecule/api-ai-anthropic",
    "@molecule/api-ai-summarization",
    "@molecule/api-ai-summarization-llm",
    "@molecule/app-audio-howler",
    "@molecule/app-virtual-scroll",
    "@molecule/app-sidebar-layout-react",
    "@molecule/app-notification-feed-react",
    "@molecule/api-resource-payment",
    "@molecule/api-payments-stripe",
    "@molecule/api-entitlements",
    "@molecule/api-email-templates",
    "@molecule/api-emails-mailgun",
    "@molecule/app-billing-react"
  ],
  "env": {
    "APP_NAME": {
      "description": "Application name",
      "default": "Podcast Platform"
    },
    "DATABASE_URL": {
      "description": "PostgreSQL connection string",
      "required": true
    },
    "MEILISEARCH_HOST": {
      "description": "MeiliSearch server URL",
      "default": "http://localhost:7700"
    },
    "MEILISEARCH_API_KEY": {
      "description": "MeiliSearch API key",
      "required": true
    },
    "S3_BUCKET": {
      "description": "S3 bucket for audio/image uploads",
      "required": true
    },
    "S3_REGION": {
      "description": "S3 region",
      "default": "us-east-1"
    },
    "S3_ACCESS_KEY_ID": {
      "description": "S3 access key",
      "required": true
    },
    "S3_SECRET_ACCESS_KEY": {
      "description": "S3 secret key",
      "required": true
    },
    "OPENAI_API_KEY": {
      "description": "OpenAI API key for transcription",
      "required": true
    },
    "STRIPE_SECRET_KEY": {
      "description": "Stripe secret API key (sk_test_... in test mode)",
      "required": true
    },
    "STRIPE_WEBHOOK_SECRET": {
      "description": "Stripe webhook signing secret (whsec_...)",
      "required": true
    },
    "STRIPE_PODCAST_PRO_MONTHLY": {
      "description": "Stripe price ID for the Pro Monthly plan",
      "required": false
    },
    "STRIPE_PODCAST_PRO_YEARLY": {
      "description": "Stripe price ID for the Pro Yearly plan",
      "required": false
    },
    "STRIPE_PODCAST_TEAM_MONTHLY": {
      "description": "Stripe price ID for the Team Monthly plan",
      "required": false
    },
    "STRIPE_PODCAST_TEAM_YEARLY": {
      "description": "Stripe price ID for the Team Yearly plan",
      "required": false
    },
    "MAILGUN_API_KEY": {
      "description": "Mailgun API key for transactional emails",
      "required": false
    },
    "MAILGUN_DOMAIN": {
      "description": "Mailgun sending domain",
      "required": false
    },
    "ANTHROPIC_API_KEY": {
      "description": "Anthropic API key for Claude",
      "required": true
    }
  },
  "layout": "dashboard",
  "features": [
    "auth",
    "search",
    "audio-player",
    "rss-feed",
    "subscriptions",
    "transcription",
    "episodes"
  ]
}
