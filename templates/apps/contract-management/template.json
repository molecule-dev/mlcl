{
  "label": "Contract Management",
  "description": "DocuSign-like contract management with templates, signing, expiry, and alerts — with built-in Stripe-backed subscription tiers",
  "cluster": "business-saas",
  "type": "full-stack",
  "framework": "react",
  "packages": [
    "@molecule/api-database-postgresql",
    "@molecule/api-resource-user",
    "@molecule/api-resource-activity-feed",
    "@molecule/api-permissions-custom",
    "@molecule/api-search-meilisearch",
    "@molecule/api-audit-database",
    "@molecule/api-uploads-s3",
    "@molecule/api-pdf-pdfkit",
    "@molecule/api-emails-mailgun",
    "@molecule/api-cron-node-cron",
    "@molecule/api-reporting-database",
    "@molecule/app-data-table",
    "@molecule/app-file-upload",
    "@molecule/app-date-range-picker",
    "@molecule/app-command-palette",
    "@molecule/api-resource-payment",
    "@molecule/api-payments-stripe",
    "@molecule/api-entitlements",
    "@molecule/api-email-templates",
    "@molecule/app-billing-react",
    "@molecule/app-sidebar-layout-react",
    "@molecule/app-notification-feed-react"
  ],
  "env": {
    "APP_NAME": {
      "description": "Application name",
      "default": "Contracts"
    },
    "DATABASE_URL": {
      "description": "PostgreSQL connection string",
      "required": true
    },
    "MEILISEARCH_HOST": {
      "description": "MeiliSearch server URL",
      "default": "http://localhost:7700"
    },
    "MEILISEARCH_API_KEY": {
      "description": "MeiliSearch API key",
      "required": true
    },
    "S3_BUCKET": {
      "description": "S3 bucket for contract files",
      "required": true
    },
    "S3_REGION": {
      "description": "S3 region",
      "default": "us-east-1"
    },
    "MAILGUN_API_KEY": {
      "description": "Mailgun API key",
      "required": true
    },
    "MAILGUN_DOMAIN": {
      "description": "Mailgun sending domain",
      "required": true
    },
    "STRIPE_SECRET_KEY": {
      "description": "Stripe secret API key (sk_test_... in test mode)",
      "required": true
    },
    "STRIPE_WEBHOOK_SECRET": {
      "description": "Stripe webhook signing secret (whsec_...)",
      "required": true
    },
    "STRIPE_CONTRACT_MANAGEMENT_PRO_MONTHLY": {
      "description": "Stripe price ID for the Pro Monthly plan",
      "required": false
    },
    "STRIPE_CONTRACT_MANAGEMENT_PRO_YEARLY": {
      "description": "Stripe price ID for the Pro Yearly plan",
      "required": false
    },
    "STRIPE_CONTRACT_MANAGEMENT_TEAM_MONTHLY": {
      "description": "Stripe price ID for the Team Monthly plan",
      "required": false
    },
    "STRIPE_CONTRACT_MANAGEMENT_TEAM_YEARLY": {
      "description": "Stripe price ID for the Team Yearly plan",
      "required": false
    }
  },
  "layout": "dashboard",
  "features": [
    "auth",
    "search",
    "contracts",
    "templates",
    "signing",
    "expiry-alerts",
    "audit-log",
    "subscriptions"
  ]
}
