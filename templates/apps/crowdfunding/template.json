{
  "label": "Crowdfunding",
  "description": "Kickstarter-like crowdfunding platform with campaigns, reward tiers, progress tracking, and backer updates — with built-in Stripe-backed subscription tiers",
  "cluster": "operations-iot",
  "type": "full-stack",
  "framework": "react",
  "packages": [
    "@molecule/api-database-postgresql",
    "@molecule/api-resource-user",
    "@molecule/api-payments-stripe",
    "@molecule/api-uploads-s3",
    "@molecule/api-image-sharp",
    "@molecule/api-emails-mailgun",
    "@molecule/api-search-meilisearch",
    "@molecule/api-resource-comment",
    "@molecule/app-data-table",
    "@molecule/app-virtual-scroll",
    "@molecule/app-charts",
    "@molecule/app-file-upload",
    "@molecule/app-markdown",
    "@molecule/app-command-palette",
    "@molecule/api-resource-payment",
    "@molecule/api-entitlements",
    "@molecule/api-email-templates",
    "@molecule/app-billing-react"
  ],
  "env": {
    "APP_NAME": {
      "description": "Application name",
      "default": "Crowdfunding"
    },
    "DATABASE_URL": {
      "description": "PostgreSQL connection string",
      "required": true
    },
    "STRIPE_SECRET_KEY": {
      "description": "Stripe secret key for payment processing",
      "required": true
    },
    "STRIPE_PUBLISHABLE_KEY": {
      "description": "Stripe publishable key for client-side",
      "required": true
    },
    "STRIPE_WEBHOOK_SECRET": {
      "description": "Stripe webhook signing secret",
      "required": true
    },
    "AWS_ACCESS_KEY_ID": {
      "description": "AWS access key for S3 uploads",
      "required": true
    },
    "AWS_SECRET_ACCESS_KEY": {
      "description": "AWS secret key for S3 uploads",
      "required": true
    },
    "AWS_S3_BUCKET": {
      "description": "S3 bucket for campaign images and assets",
      "required": true
    },
    "MEILISEARCH_HOST": {
      "description": "MeiliSearch server URL",
      "default": "http://localhost:7700"
    },
    "MEILISEARCH_API_KEY": {
      "description": "MeiliSearch API key",
      "required": true
    },
    "MAILGUN_API_KEY": {
      "description": "Mailgun API key for backer notifications",
      "required": true
    },
    "MAILGUN_DOMAIN": {
      "description": "Mailgun sending domain",
      "required": true
    },
    "STRIPE_CROWDFUNDING_PRO_MONTHLY": {
      "description": "Stripe price ID for the Pro Monthly plan",
      "required": false
    },
    "STRIPE_CROWDFUNDING_PRO_YEARLY": {
      "description": "Stripe price ID for the Pro Yearly plan",
      "required": false
    },
    "STRIPE_CROWDFUNDING_TEAM_MONTHLY": {
      "description": "Stripe price ID for the Team Monthly plan",
      "required": false
    },
    "STRIPE_CROWDFUNDING_TEAM_YEARLY": {
      "description": "Stripe price ID for the Team Yearly plan",
      "required": false
    }
  },
  "layout": "dashboard",
  "features": [
    "auth",
    "search",
    "payments",
    "uploads",
    "email-notifications",
    "image-processing",
    "subscriptions"
  ]
}
