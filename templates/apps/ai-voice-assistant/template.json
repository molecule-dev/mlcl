{
  "label": "AI Voice Assistant",
  "description": "Speech-to-text, AI processing, and text-to-speech voice assistant — with built-in Stripe-backed subscription tiers",
  "cluster": "ai-first",
  "type": "full-stack",
  "framework": "react",
  "packages": [
    "@molecule/api-database-postgresql",
    "@molecule/api-resource-user",
    "@molecule/api-ai-anthropic",
    "@molecule/api-ai-agents",
    "@molecule/api-ai-agents-llm",
    "@molecule/api-ai-speech-openai",
    "@molecule/api-ai-speech-elevenlabs",
    "@molecule/api-realtime-socketio",
    "@molecule/api-resource-thread",
    "@molecule/app-ai-voice",
    "@molecule/app-ai-assistant",
    "@molecule/app-realtime-socketio",
    "@molecule/app-timeline",
    "@molecule/api-resource-payment",
    "@molecule/api-payments-stripe",
    "@molecule/api-entitlements",
    "@molecule/api-email-templates",
    "@molecule/api-emails-mailgun",
    "@molecule/app-billing-react"
  ],
  "env": {
    "APP_NAME": {
      "description": "Application name",
      "default": "AI Voice Assistant"
    },
    "DATABASE_URL": {
      "description": "PostgreSQL connection string",
      "required": true
    },
    "ANTHROPIC_API_KEY": {
      "description": "Anthropic API key for Claude",
      "required": true
    },
    "OPENAI_API_KEY": {
      "description": "OpenAI API key for Whisper STT",
      "required": true
    },
    "ELEVENLABS_API_KEY": {
      "description": "ElevenLabs API key for TTS",
      "required": false
    },
    "STRIPE_SECRET_KEY": {
      "description": "Stripe secret API key (sk_test_... in test mode)",
      "required": true
    },
    "STRIPE_WEBHOOK_SECRET": {
      "description": "Stripe webhook signing secret (whsec_...)",
      "required": true
    },
    "STRIPE_AI_VOICE_ASSISTANT_PRO_MONTHLY": {
      "description": "Stripe price ID for the Pro Monthly plan",
      "required": false
    },
    "STRIPE_AI_VOICE_ASSISTANT_PRO_YEARLY": {
      "description": "Stripe price ID for the Pro Yearly plan",
      "required": false
    },
    "STRIPE_AI_VOICE_ASSISTANT_TEAM_MONTHLY": {
      "description": "Stripe price ID for the Team Monthly plan",
      "required": false
    },
    "STRIPE_AI_VOICE_ASSISTANT_TEAM_YEARLY": {
      "description": "Stripe price ID for the Team Yearly plan",
      "required": false
    },
    "MAILGUN_API_KEY": {
      "description": "Mailgun API key for transactional emails",
      "required": false
    },
    "MAILGUN_DOMAIN": {
      "description": "Mailgun sending domain",
      "required": false
    }
  },
  "layout": "chat",
  "features": [
    "auth",
    "speech-to-text",
    "text-to-speech",
    "ai-agents",
    "realtime",
    "subscriptions"
  ]
}
