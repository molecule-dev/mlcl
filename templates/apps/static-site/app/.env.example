# Environment variables for the static site.
# Copy to .env; nothing here is secret.

# The public origin of the site, for the absolute URLs in the feeds, the
# sitemap, llms.txt and posts.json. No trailing slash.
VITE_SITE_URL=http://localhost:3000

# Serve the site from a sub-path (a GitHub Pages project site, for example):
# set BASE_PATH when building — `BASE_PATH=/my-site npm run build`. It is a
# build-time variable, not a VITE_ one, so it is read from the shell.
