{
  "label": "Flashcard App",
  "description": "Anki-like flashcard app with spaced repetition, decks, and study statistics — with built-in Stripe-backed subscription tiers",
  "cluster": "education",
  "type": "full-stack",
  "framework": "react",
  "packages": [
    "@molecule/api-database-postgresql",
    "@molecule/api-resource-user",
    "@molecule/api-resource-tag",
    "@molecule/api-search-meilisearch",
    "@molecule/api-cron-node-cron",
    "@molecule/api-reporting-database",
    "@molecule/api-import-export-csv",
    "@molecule/api-image-sharp",
    "@molecule/api-uploads-s3",
    "@molecule/app-data-table",
    "@molecule/app-virtual-scroll",
    "@molecule/app-keyboard-shortcuts",
    "@molecule/app-command-palette",
    "@molecule/app-sidebar-layout-react",
    "@molecule/app-notification-feed-react",
    "@molecule/api-resource-payment",
    "@molecule/api-payments-stripe",
    "@molecule/api-entitlements",
    "@molecule/api-email-templates",
    "@molecule/api-emails-mailgun",
    "@molecule/app-billing-react"
  ],
  "env": {
    "APP_NAME": {
      "description": "Application name",
      "default": "Flashcard App"
    },
    "DATABASE_URL": {
      "description": "PostgreSQL connection string",
      "required": true
    },
    "S3_BUCKET": {
      "description": "S3 bucket for card images",
      "required": true
    },
    "S3_REGION": {
      "description": "S3 region",
      "default": "us-east-1"
    },
    "MEILISEARCH_URL": {
      "description": "MeiliSearch URL",
      "default": "http://localhost:7700"
    },
    "STRIPE_SECRET_KEY": {
      "description": "Stripe secret API key (sk_test_... in test mode)",
      "required": true
    },
    "STRIPE_WEBHOOK_SECRET": {
      "description": "Stripe webhook signing secret (whsec_...)",
      "required": true
    },
    "STRIPE_FLASHCARD_APP_PRO_MONTHLY": {
      "description": "Stripe price ID for the Pro Monthly plan",
      "required": false
    },
    "STRIPE_FLASHCARD_APP_PRO_YEARLY": {
      "description": "Stripe price ID for the Pro Yearly plan",
      "required": false
    },
    "STRIPE_FLASHCARD_APP_TEAM_MONTHLY": {
      "description": "Stripe price ID for the Team Monthly plan",
      "required": false
    },
    "STRIPE_FLASHCARD_APP_TEAM_YEARLY": {
      "description": "Stripe price ID for the Team Yearly plan",
      "required": false
    },
    "MAILGUN_API_KEY": {
      "description": "Mailgun API key for transactional emails",
      "required": false
    },
    "MAILGUN_DOMAIN": {
      "description": "Mailgun sending domain",
      "required": false
    }
  },
  "layout": "dashboard",
  "features": [
    "auth",
    "search",
    "keyboard-shortcuts",
    "subscriptions"
  ]
}
