{
  "label": "AI Email Composer",
  "description": "AI drafting, tone adjustment, and reusable email templates with send capability — with built-in Stripe-backed subscription tiers",
  "cluster": "ai-first",
  "type": "full-stack",
  "framework": "react",
  "packages": [
    "@molecule/api-database-postgresql",
    "@molecule/api-resource-user",
    "@molecule/api-ai-anthropic",
    "@molecule/api-ai-summarization",
    "@molecule/api-ai-summarization-llm",
    "@molecule/api-templating-handlebars",
    "@molecule/api-emails-mailgun",
    "@molecule/app-rich-text",
    "@molecule/app-ai-copilot",
    "@molecule/app-data-table",
    "@molecule/api-resource-payment",
    "@molecule/api-payments-stripe",
    "@molecule/api-entitlements",
    "@molecule/api-email-templates",
    "@molecule/app-billing-react"
  ],
  "env": {
    "APP_NAME": {
      "description": "Application name",
      "default": "AI Email Composer"
    },
    "DATABASE_URL": {
      "description": "PostgreSQL connection string",
      "required": true
    },
    "ANTHROPIC_API_KEY": {
      "description": "Anthropic API key for Claude",
      "required": true
    },
    "MAILGUN_API_KEY": {
      "description": "Mailgun API key for sending emails",
      "required": true
    },
    "MAILGUN_DOMAIN": {
      "description": "Mailgun sending domain (e.g. mg.yourdomain.com)",
      "required": true
    },
    "STRIPE_SECRET_KEY": {
      "description": "Stripe secret API key (sk_test_... in test mode)",
      "required": true
    },
    "STRIPE_WEBHOOK_SECRET": {
      "description": "Stripe webhook signing secret (whsec_...)",
      "required": true
    },
    "STRIPE_AI_EMAIL_COMPOSER_PRO_MONTHLY": {
      "description": "Stripe price ID for the Pro Monthly plan",
      "required": false
    },
    "STRIPE_AI_EMAIL_COMPOSER_PRO_YEARLY": {
      "description": "Stripe price ID for the Pro Yearly plan",
      "required": false
    },
    "STRIPE_AI_EMAIL_COMPOSER_TEAM_MONTHLY": {
      "description": "Stripe price ID for the Team Monthly plan",
      "required": false
    },
    "STRIPE_AI_EMAIL_COMPOSER_TEAM_YEARLY": {
      "description": "Stripe price ID for the Team Yearly plan",
      "required": false
    }
  },
  "layout": "dashboard",
  "features": [
    "auth",
    "ai-generation",
    "rich-text-editing",
    "email-templates",
    "email-send",
    "subscriptions"
  ]
}
