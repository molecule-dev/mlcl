{
  "label": "Course Marketplace",
  "description": "Udemy-like course marketplace with listings, enrollment, video lessons, and certificates — with built-in Stripe-backed subscription tiers",
  "cluster": "education",
  "type": "full-stack",
  "framework": "react",
  "packages": [
    "@molecule/api-database-postgresql",
    "@molecule/api-resource-user",
    "@molecule/api-resource-review",
    "@molecule/api-resource-tag",
    "@molecule/api-resource-order",
    "@molecule/api-resource-bookmark",
    "@molecule/api-payments-stripe",
    "@molecule/api-search-meilisearch",
    "@molecule/api-uploads-s3",
    "@molecule/api-media-streaming-hls",
    "@molecule/api-image-sharp",
    "@molecule/api-emails-mailgun",
    "@molecule/api-reporting-database",
    "@molecule/api-pdf-pdfkit",
    "@molecule/app-data-table",
    "@molecule/app-virtual-scroll",
    "@molecule/app-file-upload",
    "@molecule/app-command-palette",
    "@molecule/api-resource-payment",
    "@molecule/api-entitlements",
    "@molecule/api-email-templates",
    "@molecule/app-billing-react"
  ],
  "env": {
    "APP_NAME": {
      "description": "Application name",
      "default": "Course Marketplace"
    },
    "DATABASE_URL": {
      "description": "PostgreSQL connection string",
      "required": true
    },
    "STRIPE_SECRET_KEY": {
      "description": "Stripe secret key",
      "required": true
    },
    "STRIPE_PUBLISHABLE_KEY": {
      "description": "Stripe publishable key",
      "required": true
    },
    "S3_BUCKET": {
      "description": "S3 bucket for videos and assets",
      "required": true
    },
    "S3_REGION": {
      "description": "S3 region",
      "default": "us-east-1"
    },
    "MAILGUN_API_KEY": {
      "description": "Mailgun API key",
      "required": true
    },
    "MEILISEARCH_URL": {
      "description": "MeiliSearch URL",
      "default": "http://localhost:7700"
    },
    "STRIPE_WEBHOOK_SECRET": {
      "description": "Stripe webhook signing secret (whsec_...)",
      "required": true
    },
    "STRIPE_COURSE_MARKETPLACE_PRO_MONTHLY": {
      "description": "Stripe price ID for the Pro Monthly plan",
      "required": false
    },
    "STRIPE_COURSE_MARKETPLACE_PRO_YEARLY": {
      "description": "Stripe price ID for the Pro Yearly plan",
      "required": false
    },
    "STRIPE_COURSE_MARKETPLACE_TEAM_MONTHLY": {
      "description": "Stripe price ID for the Team Monthly plan",
      "required": false
    },
    "STRIPE_COURSE_MARKETPLACE_TEAM_YEARLY": {
      "description": "Stripe price ID for the Team Yearly plan",
      "required": false
    },
    "MAILGUN_DOMAIN": {
      "description": "Mailgun sending domain",
      "required": false
    }
  },
  "layout": "landing",
  "features": [
    "auth",
    "search",
    "payments",
    "video",
    "file-upload",
    "subscriptions"
  ]
}
