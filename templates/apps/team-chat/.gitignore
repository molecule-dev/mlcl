# molecule.dev platform runtime markers written into the project root by the
# sandbox (.mol-install-*, .mol-boot-timeline.log, ...) — never project source
.mol-*

# Playwright output: traces, videos, screenshots and the HTML report — regenerated
# by `npm run test:e2e`, never project source. The template keeps its runner config
# at this root; `mlcl create --template` copies it into app/, so each output
# directory is anchored to the config that writes it.
/test-results/
/app/test-results/
/playwright-report/
/app/playwright-report/
/blob-report/
/app/blob-report/
/playwright/.cache/
/app/playwright/.cache/
