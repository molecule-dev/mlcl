{
  "label": "Invoice / Billing",
  "description": "FreshBooks-like invoicing with clients, invoices, recurring billing, payments, and tax reports — with built-in Stripe-backed subscription tiers",
  "cluster": "finance",
  "type": "full-stack",
  "framework": "react",
  "packages": [
    "@molecule/api-database-postgresql",
    "@molecule/api-resource-user",
    "@molecule/api-payments-stripe",
    "@molecule/api-emails-mailgun",
    "@molecule/api-cron-node-cron",
    "@molecule/api-reporting-database",
    "@molecule/api-import-export-csv",
    "@molecule/api-middleware-validation",
    "@molecule/app-data-table",
    "@molecule/app-date-range-picker",
    "@molecule/app-virtual-scroll",
    "@molecule/api-resource-payment",
    "@molecule/api-entitlements",
    "@molecule/api-email-templates",
    "@molecule/app-billing-react"
  ],
  "env": {
    "APP_NAME": {
      "description": "Application name",
      "default": "Invoice Billing"
    },
    "DATABASE_URL": {
      "description": "PostgreSQL connection string",
      "required": true
    },
    "STRIPE_SECRET_KEY": {
      "description": "Stripe secret key for payment processing",
      "required": true
    },
    "STRIPE_PUBLISHABLE_KEY": {
      "description": "Stripe publishable key",
      "required": true
    },
    "MAILGUN_API_KEY": {
      "description": "Mailgun API key for invoice emails",
      "required": true
    },
    "STRIPE_WEBHOOK_SECRET": {
      "description": "Stripe webhook signing secret (whsec_...)",
      "required": true
    },
    "STRIPE_INVOICE_BILLING_PRO_MONTHLY": {
      "description": "Stripe price ID for the Pro Monthly plan",
      "required": false
    },
    "STRIPE_INVOICE_BILLING_PRO_YEARLY": {
      "description": "Stripe price ID for the Pro Yearly plan",
      "required": false
    },
    "STRIPE_INVOICE_BILLING_TEAM_MONTHLY": {
      "description": "Stripe price ID for the Team Monthly plan",
      "required": false
    },
    "STRIPE_INVOICE_BILLING_TEAM_YEARLY": {
      "description": "Stripe price ID for the Team Yearly plan",
      "required": false
    },
    "MAILGUN_DOMAIN": {
      "description": "Mailgun sending domain",
      "required": false
    }
  },
  "layout": "dashboard",
  "features": [
    "auth",
    "payments",
    "reports",
    "import-export",
    "subscriptions"
  ]
}
