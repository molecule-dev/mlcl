{
  "label": "Project Management",
  "description": "Asana-like task management with Kanban, milestones, and team views \u2014 including a built-in subscription tier (Free / Pro / Team) backed by Stripe",
  "cluster": "business-saas",
  "type": "full-stack",
  "framework": "react",
  "packages": [
    "@molecule/api-database-postgresql",
    "@molecule/api-email-templates",
    "@molecule/api-emails-mailgun",
    "@molecule/api-entitlements",
    "@molecule/api-payments-stripe",
    "@molecule/api-permissions-custom",
    "@molecule/api-realtime-socketio",
    "@molecule/api-resource-activity-feed",
    "@molecule/api-resource-comment",
    "@molecule/api-resource-notification",
    "@molecule/api-resource-payment",
    "@molecule/api-resource-tag",
    "@molecule/api-resource-user",
    "@molecule/api-search-meilisearch",
    "@molecule/app-billing-react",
    "@molecule/app-calendar",
    "@molecule/app-command-palette",
    "@molecule/app-data-table",
    "@molecule/app-drag-drop",
    "@molecule/app-kanban",
    "@molecule/app-keyboard-shortcuts",
    "@molecule/app-kpi-card-react",
    "@molecule/app-realtime-socketio",
    "@molecule/app-shell-layout-react"
  ],
  "env": {
    "APP_NAME": {
      "description": "Application name",
      "default": "Projects"
    },
    "DATABASE_URL": {
      "description": "PostgreSQL connection string",
      "required": true
    },
    "MEILISEARCH_HOST": {
      "description": "MeiliSearch server URL",
      "default": "http://localhost:7700"
    },
    "MEILISEARCH_API_KEY": {
      "description": "MeiliSearch API key",
      "required": true
    },
    "STRIPE_SECRET_KEY": {
      "description": "Stripe secret API key (sk_test_... in test mode)",
      "required": true
    },
    "STRIPE_WEBHOOK_SECRET": {
      "description": "Stripe webhook signing secret (whsec_...)",
      "required": true
    },
    "STRIPE_PROJECT_MANAGEMENT_PRO_MONTHLY": {
      "description": "Stripe price ID for the Pro Monthly plan",
      "required": false
    },
    "STRIPE_PROJECT_MANAGEMENT_PRO_YEARLY": {
      "description": "Stripe price ID for the Pro Yearly plan",
      "required": false
    },
    "STRIPE_PROJECT_MANAGEMENT_TEAM_MONTHLY": {
      "description": "Stripe price ID for the Team Monthly plan",
      "required": false
    },
    "STRIPE_PROJECT_MANAGEMENT_TEAM_YEARLY": {
      "description": "Stripe price ID for the Team Yearly plan",
      "required": false
    },
    "MAILGUN_API_KEY": {
      "description": "Mailgun API key for transactional emails",
      "required": false
    },
    "MAILGUN_DOMAIN": {
      "description": "Mailgun sending domain",
      "required": false
    }
  },
  "layout": "dashboard",
  "features": [
    "auth",
    "search",
    "kanban",
    "milestones",
    "realtime",
    "notifications",
    "subscriptions"
  ]
}
