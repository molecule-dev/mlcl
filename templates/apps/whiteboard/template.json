{
  "label": "Whiteboard",
  "description": "Miro-like collaborative canvas with shapes, sticky notes, drawing, and real-time cursors — with built-in Stripe-backed subscription tiers",
  "cluster": "communication",
  "type": "full-stack",
  "framework": "react",
  "packages": [
    "@molecule/api-database-postgresql",
    "@molecule/api-resource-user",
    "@molecule/api-resource-comment",
    "@molecule/api-permissions-custom",
    "@molecule/api-realtime-socketio",
    "@molecule/api-uploads-s3",
    "@molecule/api-image-sharp",
    "@molecule/api-emails-mailgun",
    "@molecule/app-realtime-socketio",
    "@molecule/app-image-crop",
    "@molecule/app-keyboard-shortcuts",
    "@molecule/api-resource-payment",
    "@molecule/api-payments-stripe",
    "@molecule/api-entitlements",
    "@molecule/api-email-templates",
    "@molecule/app-billing-react"
  ],
  "env": {
    "APP_NAME": {
      "description": "Application name",
      "default": "Whiteboard"
    },
    "DATABASE_URL": {
      "description": "PostgreSQL connection string",
      "required": true
    },
    "S3_BUCKET": {
      "description": "S3 bucket for board assets",
      "required": true
    },
    "S3_REGION": {
      "description": "S3 region",
      "default": "us-east-1"
    },
    "MAILGUN_API_KEY": {
      "description": "Mailgun API key for sharing invites",
      "required": true
    },
    "STRIPE_SECRET_KEY": {
      "description": "Stripe secret API key (sk_test_... in test mode)",
      "required": true
    },
    "STRIPE_WEBHOOK_SECRET": {
      "description": "Stripe webhook signing secret (whsec_...)",
      "required": true
    },
    "STRIPE_WHITEBOARD_PRO_MONTHLY": {
      "description": "Stripe price ID for the Pro Monthly plan",
      "required": false
    },
    "STRIPE_WHITEBOARD_PRO_YEARLY": {
      "description": "Stripe price ID for the Pro Yearly plan",
      "required": false
    },
    "STRIPE_WHITEBOARD_TEAM_MONTHLY": {
      "description": "Stripe price ID for the Team Monthly plan",
      "required": false
    },
    "STRIPE_WHITEBOARD_TEAM_YEARLY": {
      "description": "Stripe price ID for the Team Yearly plan",
      "required": false
    },
    "MAILGUN_DOMAIN": {
      "description": "Mailgun sending domain",
      "required": false
    }
  },
  "layout": "dashboard",
  "features": [
    "auth",
    "realtime",
    "canvas",
    "collaboration",
    "sharing",
    "subscriptions"
  ]
}
