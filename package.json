{
  "name": "mlcl",
  "version": "2.1.2",
  "description": "The Molecule.dev CLI — scaffold and manage production full-stack apps from a composable, swappable @molecule/* package library",
  "author": "Molecule Dev, Inc. (https://molecule.dev)",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "molecule",
    "molecule-dev",
    "scaffold",
    "generator",
    "boilerplate",
    "fullstack",
    "typescript",
    "cli",
    "ai",
    "ai-agent",
    "code-generation",
    "mcp"
  ],
  "homepage": "https://www.molecule.dev/mlcl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/molecule-dev/mlcl.git"
  },
  "bugs": {
    "url": "https://github.com/molecule-dev/mlcl/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "mlcl": "bin/run.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "/bin",
    "/dist",
    "/registry.json",
    "/templates",
    "/oclif.manifest.json",
    "/docs/AGENTS-AND-HARNESSES.md",
    "/docs/INTEGRATE-EXISTING-APP.md",
    "/docs/FROM-VIBECODING.md"
  ],
  "oclif": {
    "bin": "mlcl",
    "dirname": "mlcl",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-help"
    ],
    "topicSeparator": " ",
    "topics": {
      "stage": {
        "description": "Manage staging environments (up, down, status, logs)"
      },
      "mcp": {
        "description": "Register the molecule MCP server with coding agents"
      },
      "agent": {
        "description": "Make your AI coding agent molecule-aware"
      },
      "env": {
        "description": "Manage environment variables (local .env + molecule.dev project env)"
      },
      "db": {
        "description": "Database operations (migrate, reset, console)"
      },
      "auth": {
        "description": "molecule.dev account login/logout"
      },
      "project": {
        "description": "molecule.dev project operations"
      },
      "deploy": {
        "description": "Deploy to molecule.dev production"
      },
      "device": {
        "description": "Manage molecule.dev devices/sessions (list, revoke, rename)"
      },
      "token": {
        "description": "Personal API tokens for CI and scripts (create, list, revoke)"
      },
      "sandbox": {
        "description": "Manage project sandboxes (status, start, stop, exec)"
      },
      "snapshot": {
        "description": "Sandbox snapshots (create, list, restore, rm)"
      },
      "git": {
        "description": "Platform-mediated git (push, pull)"
      },
      "domain": {
        "description": "Custom domains (list, add, verify, rm)"
      },
      "apikey": {
        "description": "Project API keys (list, create, rm)"
      },
      "team": {
        "description": "Project team (list, invite, revoke, set-role, rm)"
      },
      "share": {
        "description": "Public share links (list, create, rm, visibility)"
      },
      "transcripts": {
        "description": "Agent session transcripts (import, list, rm)"
      },
      "build": {
        "description": "Mobile/desktop builds (mobile, desktop, list, status)"
      },
      "usage": {
        "description": "Usage and pricing tiers"
      },
      "invitations": {
        "description": "Pending team invitations (list, accept, decline)"
      },
      "profile": {
        "description": "Your molecule.dev profile (get, update)"
      },
      "vault": {
        "description": "Project vault secrets (list, set, rm, token)"
      },
      "account": {
        "description": "Account management (delete, export)"
      },
      "import": {
        "description": "Git repo import (repos, source, upload)"
      },
      "egress": {
        "description": "Sandbox network egress policy (get, approve, revoke)"
      },
      "logs": {
        "description": "Runtime logs (fetch, live stream)"
      },
      "tasks": {
        "description": "Scheduled AI tasks (list, cancel)"
      }
    },
    "hooks": {
      "init": "./dist/hooks/telemetry-init.js",
      "postrun": "./dist/hooks/telemetry-done.js",
      "command_error": "./dist/hooks/telemetry-done.js"
    }
  },
  "scripts": {
    "build": "shx rm -rf dist && tsc -b",
    "dev": "tsc -b --watch",
    "docs:check": "node bin/run.js sync-docs --check",
    "docs:check:ci": "node scripts/docs-check-ci.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:template-catalog": "node scripts/generate-template-catalog.mjs",
    "gen:template-catalog:check": "node scripts/generate-template-catalog.mjs --check",
    "lint": "eslint src/ scripts/ --max-warnings 0",
    "lint:fix": "eslint src/ --fix --max-warnings 0",
    "postpack": "shx rm -f oclif.manifest.json",
    "prepack": "npm run build && oclif manifest && oclif readme && node scripts/inject-fleet-counts.mjs",
    "prepublishOnly": "node scripts/prepublish-verify.mjs",
    "prepare": "husky",
    "registry:check": "node bin/run.js sync-registry --check",
    "sync-docs:changed": "tsx scripts/regen-molecule-docs.mjs --changed",
    "trust:new": "node scripts/trust-new-packages.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:watch": "vitest",
    "verify:auth-form-state": "node scripts/verify-auth-form-state.mjs",
    "verify:external-state": "node scripts/check-external-state-coverage.mjs",
    "verify:registry-exports": "tsx scripts/check-registry-exports.mjs",
    "verify:template-e2e-demo-data": "node scripts/verify-template-e2e-demo-data.mjs",
    "verify:template-lint": "node scripts/verify-template-lint.mjs",
    "verify:template-locales": "node scripts/check-template-locale-placeholders.js",
    "verify:template-types": "node scripts/verify-template-types.mjs",
    "sync:fleet-counts": "node scripts/inject-fleet-counts.mjs"
  },
